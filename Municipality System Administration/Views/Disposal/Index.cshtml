@using Microsoft.AspNet.Identity.EntityFramework
@using Municipality_System_Administration.Models
@using Microsoft.AspNet.Identity
@model IEnumerable<Municipality_System_Administration.Models.DisposalRequest>

@{
    ViewBag.Title = "Disposal Requests";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .page-header {
        background: linear-gradient(135deg, #0f4c81, #1f7a8c);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-box {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,.08);
    }

    .stat-card {
        background: white;
        padding: 15px;
        border-radius: 10px;
        text-align: center;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        border-left: 4px solid #0f4c81;
        transition: transform 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .stat-number {
        font-size: 1.8rem;
        font-weight: bold;
        color: #0f4c81;
    }

    .stat-label {
        color: #6c757d;
        font-size: 0.85rem;
    }

    .filter-section {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .filter-select {
        display: inline-block;
        margin-right: 10px;
    }

    .form-control {
        display: block;
        width: 100%;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
    }

    .table thead {
        background: #0f4c81;
        color: white;
    }

        .table thead th {
            color: white;
            padding: 12px 15px;
        }

    .table tbody td {
        padding: 12px 15px;
        vertical-align: middle;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-pending {
        background: #fd7e14;
        color: white;
    }

    .status-approved {
        background: #28a745;
        color: white;
    }

    .status-rejected {
        background: #dc3545;
        color: white;
    }

    .btn-sm {
        padding: 4px 10px;
        font-size: 12px;
        line-height: 1.5;
        border-radius: 4px;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 30px;
    }

        .btn-sm i {
            font-size: 13px;
        }

    .action-buttons {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

    .btn-primary {
        color: #fff;
        background-color: #007bff;
        border-color: #007bff;
    }

        .btn-primary:hover {
            background-color: #0069d9;
        }

    .btn-secondary {
        color: #fff;
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .btn-info {
        color: #fff;
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

        .btn-info:hover {
            background-color: #138496;
        }

    .btn-success {
        color: #fff;
        background-color: #28a745;
        border-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    .btn-danger {
        color: #fff;
        background-color: #dc3545;
        border-color: #dc3545;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }

    .badge-secondary {
        background: #6c757d;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .text-muted {
        color: #6c757d !important;
    }

    .text-center {
        text-align: center !important;
    }

    .py-5 {
        padding-top: 3rem !important;
        padding-bottom: 3rem !important;
    }

    .mb-4 {
        margin-bottom: 1.5rem !important;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -15px;
        margin-left: -15px;
    }

    .col-md-2 {
        position: relative;
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        flex: 0 0 16.666667%;
        max-width: 16.666667%;
    }

    .container {
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        margin-right: auto;
        margin-left: auto;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    .alert {
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        border: 1px solid transparent;
        border-radius: 0.25rem;
    }

    .alert-success {
        color: #155724;
        background-color: #d4edda;
        border-color: #c3e6cb;
    }

    .alert-danger {
        color: #721c24;
        background-color: #f8d7da;
        border-color: #f5c6cb;
    }

    .alert-dismissible {
        padding-right: 4rem;
    }

    .close {
        float: right;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        color: #000;
        opacity: .5;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
    }

    @@media (max-width: 768px) {
        .table-responsive {
            overflow-x: auto;
        }

        .col-md-2 {
            flex: 0 0 50%;
            max-width: 50%;
            margin-bottom: 10px;
        }

        .filter-select {
            display: block;
            width: 100%;
            margin-bottom: 10px;
        }

        .action-buttons .btn {
            min-width: 28px;
            height: 28px;
            padding: 3px 8px;
        }

            .action-buttons .btn i {
                font-size: 11px;
            }
    }
</style>

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert">×</button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert">×</button>
        </div>
    }

    <div class="page-header">
        <h2><i class="fa fa-recycle"></i> Disposal Requests</h2>
        <p>Manage asset disposal requests.</p>
        @if (User.IsInRole("FinanceOfficer"))
        {
            <p class="text-white-50" style="font-size: 0.9rem; margin-top: 5px;">
                <i class="fa fa-info-circle"></i> You have <strong>@ViewBag.PendingCount</strong> pending disposal requests awaiting your review.
            </p>
        }
    </div>

    <!-- Statistics -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="stat-card" style="border-left-color: #0f4c81;">
                <div class="stat-number">@ViewBag.TotalRequests</div>
                <div class="stat-label"><i class="fa fa-list"></i> Total</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card" style="border-left-color: #fd7e14;">
                <div class="stat-number">@ViewBag.PendingCount</div>
                <div class="stat-label"><i class="fa fa-clock"></i> Pending</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card" style="border-left-color: #28a745;">
                <div class="stat-number">@ViewBag.ApprovedCount</div>
                <div class="stat-label"><i class="fa fa-check"></i> Approved</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card" style="border-left-color: #dc3545;">
                <div class="stat-number">@ViewBag.RejectedCount</div>
                <div class="stat-label"><i class="fa fa-times"></i> Rejected</div>
            </div>
        </div>
    </div>

    <div class="card-box">

        <!-- Filter Section -->
        <div class="filter-section">
            <div class="form-inline">
                <div class="filter-select">
                    <select id="statusFilter" class="form-control" onchange="applyFilter()">
                        <option value="All" @(ViewBag.SelectedStatus == "All" || string.IsNullOrEmpty(ViewBag.SelectedStatus) ? "selected" : "")>All Statuses</option>
                        <option value="Pending" @(ViewBag.SelectedStatus == "Pending" ? "selected" : "")>Pending</option>
                        <option value="Approved" @(ViewBag.SelectedStatus == "Approved" ? "selected" : "")>Approved</option>
                        <option value="Rejected" @(ViewBag.SelectedStatus == "Rejected" ? "selected" : "")>Rejected</option>
                    </select>
                </div>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fa fa-sync"></i> Reset
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered" id="disposalTable">
                <thead>
                    <tr>
                        <th>Request ID</th>
                        <th>Asset</th>
                        <th>Requested By</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Request Date</th>
                        <th style="min-width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        using (var db = new ApplicationDbContext())
                        {
                            var userManager = new UserManager<ApplicationUser>(new UserStore<ApplicationUser>(db));

                            foreach (var item in Model)
                            {
                                string statusClass = "status-" + (item.Status?.ToLower() ?? "pending");
                                var requestedBy = userManager.FindById(item.RequestedByUserId);
                                var asset = db.Assets.Find(item.AssetId);

                                <tr>
                                    <td><strong>#@item.DisposalRequestId</strong></td>
                                    <td>
                                        <i class="fa fa-box"></i> @(asset?.AssetName ?? "Unknown")
                                        <br /><small class="text-muted">@(asset?.AssetNumber ?? "N/A")</small>
                                    </td>
                                    <td>@(requestedBy?.UserName ?? "Unknown")</td>
                                    <td><span class="badge-secondary">@(item.DisposalMethod ?? "Pending")</span></td>
                                    <td><span class="status-badge @statusClass"><i class="fa fa-circle"></i> @item.Status</span></td>
                                    <td>@item.RequestDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="action-buttons">
                                            <!-- View Details -->
                                            <a href="@Url.Action("Details", "Disposal", new { id = item.DisposalRequestId })"
                                               class="btn btn-info btn-sm" title="View Details">
                                                <i class="fa fa-eye"></i>
                                            </a>

                                            <!-- Finance Review (Finance Officer only) -->
                                            @if (User.IsInRole("FinanceOfficer") && item.Status == "Pending")
                                            {
                                                <a href="@Url.Action("FinanceReview", "Disposal", new { id = item.DisposalRequestId })"
                                                   class="btn btn-primary btn-sm" title="Review Request">
                                                    <i class="fa fa-coins"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="text-center py-5">
                                    <i class="fa fa-recycle fa-3x text-muted mb-3"></i>
                                    <h4>No disposal requests found</h4>
                                    <p class="text-muted">There are no disposal requests to display.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function applyFilter() {
        var status = document.getElementById('statusFilter').value;
        var url = '@Url.Action("Index")';
        if (status && status !== 'All') {
            url += '?status=' + encodeURIComponent(status);
        }
        window.location.href = url;
    }
</script>