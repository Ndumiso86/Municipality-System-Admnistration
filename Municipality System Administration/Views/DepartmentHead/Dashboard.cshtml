@using Municipality_System_Administration.Models
@{
    ViewBag.Title = "Department Head Dashboard";
    var recentRepairs = ViewBag.RecentRepairs as List<Asset> ?? new List<Asset>();
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .page-header {
        background: linear-gradient(135deg, #f39c12, #d68910);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
        transition: transform 0.3s;
        border-left: 4px solid #f39c12;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .stat-number {
        font-size: 2.5rem;
        font-weight: bold;
        color: #f39c12;
    }

    .stat-label {
        color: #6c757d;
        font-size: 0.9rem;
        margin-top: 5px;
    }

    .stat-icon {
        font-size: 2rem;
        margin-bottom: 10px;
    }

    .card-custom {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
    }

    .table thead {
        background: #f39c12;
        color: white;
    }

        .table thead th {
            color: white;
            padding: 12px 15px;
        }

    .table tbody td {
        padding: 12px 15px;
        vertical-align: middle;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-pending {
        background: #fd7e14;
        color: white;
    }

    .status-approved {
        background: #28a745;
        color: white;
    }

    .btn-sm {
        padding: 4px 10px;
        font-size: 12px;
        line-height: 1.5;
        border-radius: 4px;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 30px;
    }

        .btn-sm i {
            font-size: 13px;
        }

    .btn-success {
        color: #fff;
        background-color: #28a745;
        border-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

    .btn-danger {
        color: #fff;
        background-color: #dc3545;
        border-color: #dc3545;
    }

        .btn-danger:hover {
            background-color: #c82333;
            border-color: #bd2130;
        }

    .btn-info {
        color: #fff;
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

        .btn-info:hover {
            background-color: #138496;
            border-color: #117a8b;
        }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -15px;
        margin-left: -15px;
    }

    .col-md-3, .col-md-6 {
        position: relative;
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
    }

    .col-md-3 {
        flex: 0 0 25%;
        max-width: 25%;
    }

    .col-md-6 {
        flex: 0 0 50%;
        max-width: 50%;
    }

    .container {
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        margin-right: auto;
        margin-left: auto;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    .mb-4 {
        margin-bottom: 1.5rem !important;
    }

    .text-center {
        text-align: center !important;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .alert {
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        border: 1px solid transparent;
        border-radius: 0.25rem;
    }

    .alert-success {
        color: #155724;
        background-color: #d4edda;
        border-color: #c3e6cb;
    }

    .alert-dismissible {
        padding-right: 4rem;
    }

    .close {
        float: right;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        color: #000;
        text-shadow: 0 1px 0 #fff;
        opacity: .5;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
    }

    .btn {
        display: inline-block;
        font-weight: 400;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        line-height: 1.5;
        border-radius: 0.25rem;
        transition: color .15s ease-in-out, background-color .15s ease-in-out, border-color .15s ease-in-out, box-shadow .15s ease-in-out;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-primary {
        color: #fff;
        background-color: #007bff;
        border-color: #007bff;
    }

        .btn-primary:hover {
            background-color: #0069d9;
            border-color: #0062cc;
        }

    .btn-secondary {
        color: #fff;
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }

    @@media (max-width: 768px) {
        .col-md-3, .col-md-6 {
            flex: 0 0 100%;
            max-width: 100%;
            margin-bottom: 15px;
        }
    }
</style>

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i>
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle"></i>
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="page-header">
        <h2>
            <i class="fa fa-sitemap"></i>
            Department Head Dashboard
        </h2>
        <p>Welcome, @User.Identity.Name! Manage repair approvals and department reports.</p>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #fd7e14;">
                <div class="stat-icon text-warning">
                    <i class="fa fa-clock"></i>
                </div>
                <div class="stat-number">@ViewBag.PendingRepairs</div>
                <div class="stat-label">Pending Repairs</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #28a745;">
                <div class="stat-icon text-success">
                    <i class="fa fa-check-circle"></i>
                </div>
                <div class="stat-number">@ViewBag.ApprovedRepairs</div>
                <div class="stat-label">Approved Repairs</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #007bff;">
                <div class="stat-icon text-primary">
                    <i class="fa fa-spinner"></i>
                </div>
                <div class="stat-number">@ViewBag.InProgressRepairs</div>
                <div class="stat-label">In Progress</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #17a2b8;">
                <div class="stat-icon text-info">
                    <i class="fa fa-check-double"></i>
                </div>
                <div class="stat-number">@ViewBag.CompletedRepairs</div>
                <div class="stat-label">Completed Repairs</div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card-custom">
                <h4><i class="fa fa-bolt"></i> Quick Actions</h4>
                <hr />
                <div class="row">
                    <div class="col-md-3">
                        <a href="@Url.Action("PendingRepairs")" class="btn btn-primary btn-block">
                            <i class="fa fa-clock"></i> Pending Repairs
                            @if (ViewBag.PendingRepairs > 0)
                            {
                                <span class="badge badge-danger" style="background: #dc3545; color: white; margin-left: 5px;">@ViewBag.PendingRepairs</span>
                            }
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a href="@Url.Action("RepairHistory")" class="btn btn-info btn-block">
                            <i class="fa fa-history"></i> Repair History
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a href="@Url.Action("StaffReport")" class="btn btn-success btn-block">
                            <i class="fa fa-users"></i> Staff Report
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a href="@Url.Action("Reports")" class="btn btn-warning btn-block">
                            <i class="fa fa-chart-bar"></i> Reports
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (recentRepairs.Any())
    {
        <div class="card-custom">
            <h4><i class="fa fa-tools"></i> Recent Repair Requests</h4>
            <hr />
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Asset</th>
                            <th>Asset Name</th>
                            <th>Status</th>
                            <th>Requested</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in recentRepairs.Take(5))
                        {
                            <tr>
                                <td>@item.AssetNumber</td>
                                <td>@item.AssetName</td>
                                <td>
                                    <span class="status-badge status-pending">
                                        <i class="fa fa-circle"></i>
                                        @(item.RepairStatus ?? "Pending")
                                    </span>
                                </td>
                                <td>@item.RepairRequestDate?</td>
                                <td>
                                    <a href="@Url.Action("ApproveRepair", new { id = item.AssetId })" class="btn btn-success btn-sm" title="Approve">
                                        <i class="fa fa-check"></i>
                                    </a>
                                    <a href="@Url.Action("RejectRepair", new { id = item.AssetId })" class="btn btn-danger btn-sm" title="Reject">
                                        <i class="fa fa-times"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (recentRepairs.Count > 5)
            {
                <div class="text-center">
                    <a href="@Url.Action("PendingRepairs")" class="btn btn-primary">View All Repairs</a>
                </div>
            }
        </div>
    }

</div>

