@using Municipality_System_Administration.Models
@using Microsoft.AspNet.Identity
@using Microsoft.AspNet.Identity.EntityFramework
@model IEnumerable<Municipality_System_Administration.Models.Staff>

@{
    ViewBag.Title = "Staff Report";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .page-header {
        background: linear-gradient(135deg, #17a2b8, #0d6efd);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-box {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
    }

    .table thead {
        background: #0f4c81;
        color: white;
    }

        .table thead th {
            color: white;
            padding: 12px 15px;
        }

    .table tbody td {
        padding: 12px 15px;
        vertical-align: middle;
    }

    .status-active {
        background: #198754;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        display: inline-block;
    }

    .status-inactive {
        background: #dc3545;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        display: inline-block;
    }

    .role-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-block;
    }

    .role-admin {
        background: #8e44ad;
        color: white;
    }

    .role-assetmanager {
        background: #2980b9;
        color: white;
    }

    .role-municipalemployee {
        background: #27ae60;
        color: white;
    }

    .role-departmenthead {
        background: #f39c12;
        color: white;
    }

    .role-technician {
        background: #e67e22;
        color: white;
    }

    .role-financeofficer {
        background: #2c3e50;
        color: white;
    }

    .role-default {
        background: #95a5a6;
        color: white;
    }

    .btn {
        display: inline-block;
        font-weight: 400;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        line-height: 1.5;
        border-radius: 0.25rem;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-info {
        color: #fff;
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

        .btn-info:hover {
            background-color: #138496;
            border-color: #117a8b;
        }

    .btn-secondary {
        color: #fff;
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }

    .btn-sm {
        padding: 4px 10px;
        font-size: 12px;
        line-height: 1.5;
        border-radius: 4px;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 30px;
    }

        .btn-sm i {
            font-size: 13px;
        }

    .container {
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        margin-right: auto;
        margin-left: auto;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    .mb-3 {
        margin-bottom: 1rem !important;
    }

    .text-center {
        text-align: center !important;
    }

    .py-5 {
        padding-top: 3rem !important;
        padding-bottom: 3rem !important;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .alert {
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        border: 1px solid transparent;
        border-radius: 0.25rem;
    }

    .alert-success {
        color: #155724;
        background-color: #d4edda;
        border-color: #c3e6cb;
    }

    .alert-dismissible {
        padding-right: 4rem;
    }

    .close {
        float: right;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        color: #000;
        text-shadow: 0 1px 0 #fff;
        opacity: .5;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
    }

    .stats-summary {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

        .stats-summary span {
            margin-right: 25px;
        }

    .search-box {
        max-width: 300px;
        display: inline-block;
        float: right;
    }

    .clearfix::after {
        content: "";
        clear: both;
        display: table;
    }

    .form-control {
        display: block;
        width: 100%;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        line-height: 1.5;
        color: #495057;
        background-color: #fff;
        background-clip: padding-box;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        transition: border-color .15s ease-in-out,box-shadow .15s ease-in-out;
    }

    @@media (max-width: 768px) {
        .table-responsive {
            overflow-x: auto;
        }

        .stats-summary span {
            display: block;
            margin-bottom: 5px;
        }

        .search-box {
            max-width: 100%;
            float: none;
            margin-top: 10px;
        }

        .float-right {
            float: none !important;
        }
    }
</style>

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i>
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="page-header">
        <h2>
            <i class="fa fa-users"></i>
            Staff Report
        </h2>
        <p>View all staff members and their roles.</p>
    </div>

    <div class="card-box">

        <div class="clearfix mb-3">
            <div class="float-left">
                <a href="@Url.Action("Dashboard")" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
            <div class="float-right">
                <input type="text" id="searchInput" class="form-control search-box" placeholder="Search staff..." />
            </div>
        </div>

        <!-- Summary Statistics -->
        <div class="stats-summary">
            <span><strong>Total Staff:</strong> @Model.Count()</span>
            <span><strong>Active:</strong> @Model.Count(s => s.IsActive)</span>
            <span><strong>Inactive:</strong> @Model.Count(s => !s.IsActive)</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered" id="staffTable">
                <thead>
                    <tr>
                        <th>Employee No</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Date Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        using (var db = new ApplicationDbContext())
                        {
                            var userManager = new UserManager<ApplicationUser>(
                                new UserStore<ApplicationUser>(db));

                            foreach (var item in Model)
                            {
                                string roleName = "No Role";
                                string roleClass = "role-default";

                                try
                                {
                                    var roles = userManager.GetRoles(item.UserId);
                                    if (roles.Any())
                                    {
                                        roleName = roles.FirstOrDefault() ?? "No Role";

                                        switch (roleName.ToLower())
                                        {
                                            case "admin": roleClass = "role-admin"; break;
                                            case "assetmanager": roleClass = "role-assetmanager"; break;
                                            case "municipalemployee": roleClass = "role-municipalemployee"; break;
                                            case "departmenthead": roleClass = "role-departmenthead"; break;
                                            case "technician": roleClass = "role-technician"; break;
                                            case "financeofficer": roleClass = "role-financeofficer"; break;
                                            default: roleClass = "role-default"; break;
                                        }
                                    }
                                }
                                catch
                                {
                                    roleName = "Error";
                                    roleClass = "role-default";
                                }

                                <tr>
                                    <td>
                                        <strong>@item.EmployeeNumber</strong>
                                    </td>
                                    <td>
                                        <i class="fa fa-user-circle"></i>
                                        @item.FullName
                                    </td>
                                    <td>
                                        <a href="mailto:@item.Email" style="color: #0f4c81;">
                                            <i class="fa fa-envelope"></i>
                                            @item.Email
                                        </a>
                                    </td>
                                    <td>
                                        <a href="tel:@item.PhoneNumber" style="color: #0f4c81;">
                                            <i class="fa fa-phone"></i>
                                            @item.PhoneNumber
                                        </a>
                                    </td>
                                    <td>
                                        <span class="role-badge @roleClass">
                                            <i class="fa fa-shield-alt"></i>
                                            @roleName
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="status-active">
                                                <i class="fa fa-check-circle"></i>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-inactive">
                                                <i class="fa fa-times-circle"></i>
                                                Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @item.DateCreated.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <a href="@Url.Action("Details", "Staff", new { id = item.StaffId })"
                                               class="btn btn-info btn-sm"
                                               title="View Details">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="text-center py-5">
                                    <i class="fa fa-users fa-3x text-muted mb-3"></i>
                                    <h4>No staff members found</h4>
                                    <p class="text-muted">There are no staff members to display.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Simple search functionality
            $('#searchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('#staffTable tbody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}

