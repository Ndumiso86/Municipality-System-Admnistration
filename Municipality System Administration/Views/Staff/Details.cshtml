@using Microsoft.AspNet.Identity
@using Microsoft.AspNet.Identity.EntityFramework
@using Municipality_System_Administration.Models

@model Municipality_System_Administration.Models.Staff

@{
    ViewBag.Title = "Staff Details";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .header {
        background: linear-gradient(135deg,#0f4c81,#1f7a8c);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-custom {
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,.08);
    }

    .detail-label {
        font-weight: 600;
        color: #0f4c81;
        margin-bottom: 5px;
    }

    .detail-value {
        font-size: 1.1rem;
        padding: 8px 12px;
        background: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .status-badge {
        padding: 8px 20px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 1rem;
    }

    .status-active {
        background: #198754;
        color: white;
    }

    .status-disabled {
        background: #dc3545;
        color: white;
    }

    .info-card {
        border-left: 4px solid #0f4c81;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .role-badge {
        background: #0f4c81;
        color: white;
        padding: 8px 20px;
        border-radius: 20px;
        display: inline-block;
        font-weight: 600;
    }

    .employee-badge {
        background: #e9ecef;
        padding: 8px 15px;
        border-radius: 20px;
        font-weight: 600;
        color: #0f4c81;
        display: inline-block;
        margin-right: 10px;
    }
</style>

<div class="container mt-4">

    <div class="header">
        <h2>
            <i class="fa fa-user-circle"></i>
            Staff Member Details
        </h2>
        <p>View complete employee information.</p>
    </div>

    <div class="card-custom">

        <div class="row">
            <div class="col-md-12">
                <div class="info-card">
                    <div class="row">
                        <div class="col-md-6">
                            <h4>
                                <i class="fa fa-user"></i>
                                @Model.FullName
                            </h4>
                        </div>
                        <div class="col-md-6 text-right">
                            <span class="employee-badge">
                                <i class="fa fa-id-badge"></i>
                                @Model.EmployeeNumber
                            </span>
                            @if (Model.IsActive)
                            {
                                <span class="status-badge status-active">
                                    <i class="fa fa-check-circle"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-disabled">
                                    <i class="fa fa-times-circle"></i> Disabled
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">

            <div class="col-md-6">
                <div class="detail-label">
                    <i class="fa fa-user"></i> First Name
                </div>
                <div class="detail-value">
                    @Model.FirstName
                </div>

                <div class="detail-label">
                    <i class="fa fa-user"></i> Last Name
                </div>
                <div class="detail-value">
                    @Model.LastName
                </div>

                <div class="detail-label">
                    <i class="fa fa-envelope"></i> Email Address
                </div>
                <div class="detail-value">
                    <a href="mailto:@Model.Email">@Model.Email</a>
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-label">
                    <i class="fa fa-phone"></i> Phone Number
                </div>
                <div class="detail-value">
                    <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a>
                </div>

                <div class="detail-label">
                    <i class="fa fa-id-card"></i> Employee Number
                </div>
                <div class="detail-value">
                    <strong>@Model.EmployeeNumber</strong>
                </div>

                <div class="detail-label">
                    <i class="fa fa-calendar"></i> Date Created
                </div>
                <div class="detail-value">
                    @Model.DateCreated.ToString("dd MMMM yyyy HH:mm")
                </div>
            </div>

        </div>

        <div class="row mt-3">
            <div class="col-md-12">
                <div class="detail-label">
                    <i class="fa fa-user-tag"></i> System Role
                </div>
                <div class="detail-value">
                    @{
                        try
                        {
                            using (var db = new ApplicationDbContext())
                            {
                                var userManager = new UserManager<ApplicationUser>(
                                    new UserStore<ApplicationUser>(db));
                                var roles = userManager.GetRoles(Model.UserId);
                                var role = roles.FirstOrDefault() ?? "No Role Assigned";
                                <span class="role-badge">
                                    <i class="fa fa-shield-alt"></i>
                                    @role
                                </span>
                            }
                        }
                        catch
                        {
                            <span class="role-badge" style="background: #dc3545;">
                                <i class="fa fa-exclamation-triangle"></i>
                                Role not found
                            </span>
                        }
                    }
                </div>
            </div>
        </div>

        <hr />

        <div class="row">
            <div class="col-md-12">
                <a href="@Url.Action("Edit", new { id = Model.StaffId })" class="btn btn-primary">
                    <i class="fa fa-edit"></i>
                    Edit
                </a>

                @if (Model.IsActive)
                {
                    <a href="@Url.Action("Disable", new { id = Model.StaffId })" class="btn btn-warning">
                        <i class="fa fa-ban"></i>
                        Disable
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Enable", new { id = Model.StaffId })" class="btn btn-success">
                        <i class="fa fa-check"></i>
                        Enable
                    </a>
                }

                <a href="@Url.Action("Delete", new { id = Model.StaffId })" class="btn btn-danger">
                    <i class="fa fa-trash"></i>
                    Delete
                </a>

                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i>
                    Back to List
                </a>
            </div>
        </div>

    </div>

</div>
