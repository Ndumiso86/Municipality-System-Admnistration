@model Municipality_System_Administration.Models.Staff

@{
    ViewBag.Title = "Create Staff";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .header {
        background: linear-gradient(135deg,#0f4c81,#1f7a8c);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-custom {
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,.08);
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        font-weight: 600;
        margin-bottom: 6px;
    }

    .text-danger {
        font-size: 0.875rem;
    }

    .alert-custom {
        border-radius: 10px;
        padding: 15px 20px;
        margin-bottom: 20px;
    }

    .required:after {
        content: " *";
        color: red;
        font-weight: bold;
    }
</style>

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show alert-custom" role="alert">
            <i class="fa fa-check-circle"></i>
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
    {
        <div class="alert alert-danger alert-dismissible fade show alert-custom" role="alert">
            <i class="fa fa-exclamation-circle"></i>
            <strong>Please correct the following errors:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var modelState in ViewData.ModelState.Values)
                {
                    foreach (var error in modelState.Errors)
                    {
                        <li>@error.ErrorMessage</li>
                    }
                }
            </ul>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="header">
        <h2>
            <i class="fa fa-user-plus"></i>
            Create Staff Member
        </h2>
        <p>Add a new municipal employee account.</p>
    </div>

    <div class="card-custom">

        @using (Html.BeginForm("Create", "Staff", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.FirstName, new { @class = "required" })
                        @Html.TextBoxFor(m => m.FirstName,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter first name"
                            })
                        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.LastName, new { @class = "required" })
                        @Html.TextBoxFor(m => m.LastName,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter last name"
                            })
                        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                    </div>
                </div>

            </div>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Employee Number</label>
                        <input class="form-control"
                               value="Generated Automatically"
                               readonly
                               disabled />
                        <small class="text-muted">
                            <i class="fa fa-info-circle"></i>
                            Auto-generated when saved
                        </small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.PhoneNumber, new { @class = "required" })
                        @Html.TextBoxFor(m => m.PhoneNumber,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter phone number"
                            })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                    </div>
                </div>

            </div>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Email, new { @class = "required" })
                        @Html.TextBoxFor(m => m.Email,
                            new
                            {
                                @class = "form-control",
                                placeholder = "employee@municipality.gov.za",
                                type = "email"
                            })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label for="Role" class="required">System Role</label>
                        @Html.DropDownList(
                            "Role",
                            (SelectList)ViewBag.Role,
                            "-- Select Role --",
                            new { @class = "form-control", required = "required" })
                        @Html.ValidationMessage("Role", "", new { @class = "text-danger" })
                        <small class="text-muted">
                            <i class="fa fa-info-circle"></i>
                            Choose from: Admin, AssetManager, MunicipalEmployee, DepartmentHead, Technician, FinanceOfficer
                        </small>
                    </div>
                </div>

            </div>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label for="password" class="required">Password</label>
                        <input type="password"
                               name="password"
                               id="password"
                               class="form-control"
                               placeholder="Enter password"
                               required />
                        <small class="text-muted">
                            <i class="fa fa-info-circle"></i>
                            Must be at least 6 characters with uppercase, lowercase, and numbers
                        </small>
                        @Html.ValidationMessage("password", "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label for="confirmPassword">Confirm Password</label>
                        <input type="password"
                               name="confirmPassword"
                               id="confirmPassword"
                               class="form-control"
                               placeholder="Confirm password" />
                        <span id="passwordMatch" class="text-danger"></span>
                    </div>
                </div>

            </div>

            <hr />

            <div class="row">
                <div class="col-md-12">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fa fa-save"></i>
                        Create Employee
                    </button>

                    <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                        <i class="fa fa-arrow-left"></i>
                        Back to List
                    </a>
                </div>
            </div>

        }

    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {

            $('#confirmPassword').on('keyup', function () {
                var password = $('#password').val();
                var confirmPassword = $(this).val();

                if (password !== confirmPassword) {
                    $('#passwordMatch').text('Passwords do not match!');
                    $(this).css('border-color', 'red');
                } else {
                    $('#passwordMatch').text('');
                    $(this).css('border-color', '#ced4da');
                }
            });

            $('#password').on('keyup', function () {
                var password = $(this).val();
                var confirmPassword = $('#confirmPassword').val();

                if (confirmPassword.length > 0 && password !== confirmPassword) {
                    $('#passwordMatch').text('Passwords do not match!');
                    $('#confirmPassword').css('border-color', 'red');
                } else if (confirmPassword.length > 0) {
                    $('#passwordMatch').text('');
                    $('#confirmPassword').css('border-color', '#ced4da');
                }
            });

            $('form').submit(function (e) {
                var isValid = true;
                var errorMessage = '';

                var role = $('#Role').val();
                if (!role || role === '') {
                    errorMessage += 'Please select a role.\n';
                    isValid = false;
                }

                var password = $('#password').val();
                if (!password || password.length < 6) {
                    errorMessage += 'Password must be at least 6 characters long.\n';
                    isValid = false;
                }

                var confirmPassword = $('#confirmPassword').val();
                if (password !== confirmPassword) {
                    errorMessage += 'Passwords do not match.\n';
                    isValid = false;
                }

                if (!isValid) {
                    alert(errorMessage);
                    e.preventDefault();
                    return false;
                }

                return true;
            });
        });
    </script>
}
