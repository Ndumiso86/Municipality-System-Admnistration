@using Municipality_System_Administration.Models
@model Municipality_System_Administration.Models.Staff
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "My Profile";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .page-header {
        background: linear-gradient(135deg, #0f4c81, #1f7a8c);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-custom {
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
        margin-bottom: 20px;
    }

    .profile-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0f4c81, #1f7a8c);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px auto;
        font-size: 3rem;
        color: white;
        border: 4px solid #fff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        font-weight: 600;
        margin-bottom: 6px;
    }

    .form-control {
        display: block;
        width: 100%;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        line-height: 1.5;
        color: #495057;
        background-color: #fff;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
    }

        .form-control:focus {
            border-color: #80bdff;
            outline: 0;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

        .form-control[readonly] {
            background-color: #e9ecef;
        }

    .btn {
        display: inline-block;
        font-weight: 400;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.5rem 1rem;
        font-size: 1rem;
        line-height: 1.5;
        border-radius: 0.25rem;
        transition: color .15s ease-in-out, background-color .15s ease-in-out, border-color .15s ease-in-out, box-shadow .15s ease-in-out;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-primary {
        color: #fff;
        background-color: #007bff;
        border-color: #007bff;
    }

        .btn-primary:hover {
            background-color: #0069d9;
            border-color: #0062cc;
        }

    .btn-secondary {
        color: #fff;
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }

    .btn-success {
        color: #fff;
        background-color: #28a745;
        border-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

    .role-badge {
        padding: 6px 15px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-block;
        margin: 3px;
    }

    .role-admin {
        background: #8e44ad;
        color: white;
    }

    .role-assetmanager {
        background: #2980b9;
        color: white;
    }

    .role-municipalemployee {
        background: #27ae60;
        color: white;
    }

    .role-departmenthead {
        background: #f39c12;
        color: white;
    }

    .role-technician {
        background: #e67e22;
        color: white;
    }

    .role-financeofficer {
        background: #2c3e50;
        color: white;
    }

    .role-default {
        background: #95a5a6;
        color: white;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -15px;
        margin-left: -15px;
    }

    .col-md-6, .col-md-12 {
        position: relative;
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
    }

    .col-md-6 {
        flex: 0 0 50%;
        max-width: 50%;
    }

    .col-md-12 {
        flex: 0 0 100%;
        max-width: 100%;
    }

    .container {
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        margin-right: auto;
        margin-left: auto;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    .mb-3 {
        margin-bottom: 1rem !important;
    }

    .text-center {
        text-align: center !important;
    }

    hr {
        margin-top: 1rem;
        margin-bottom: 1rem;
        border: 0;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    .alert {
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        border: 1px solid transparent;
        border-radius: 0.25rem;
    }

    .alert-success {
        color: #155724;
        background-color: #d4edda;
        border-color: #c3e6cb;
    }

    .alert-danger {
        color: #721c24;
        background-color: #f8d7da;
        border-color: #f5c6cb;
    }

    .alert-dismissible {
        padding-right: 4rem;
    }

    .close {
        float: right;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        color: #000;
        text-shadow: 0 1px 0 #fff;
        opacity: .5;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
    }

    .info-item {
        padding: 8px 0;
        border-bottom: 1px solid #f1f3f5;
    }

    .info-label {
        font-weight: 600;
        color: #6c757d;
    }

    @@media (max-width: 768px) {
        .col-md-6 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }
</style>

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i>
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="page-header">
        <h2>
            <i class="fa fa-user-circle"></i>
            My Profile
        </h2>
        <p>View and manage your personal information.</p>
    </div>

    <div class="card-custom">

        <div class="text-center mb-3">
            <div class="profile-avatar">
                <i class="fa fa-user"></i>
            </div>
            <h3>@Model.FullName</h3>
            <p class="text-muted">@Model.EmployeeNumber</p>
            <div>
                @{
                    var userId = User.Identity.GetUserId();
                    var userManager = new Microsoft.AspNet.Identity.UserManager<ApplicationUser>(
                        new Microsoft.AspNet.Identity.EntityFramework.UserStore<ApplicationUser>(
                            new ApplicationDbContext()));
                    var roles = userManager.GetRoles(userId);
                    foreach (var role in roles)
                    {
                        string roleClass = "role-" + role.ToLower();
                        <span class="role-badge @roleClass">
                            <i class="fa fa-shield-alt"></i> @role
                        </span>
                    }
                }
            </div>
        </div>

        @using (Html.BeginForm("MyProfile", "Staff", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.StaffId)
            @Html.HiddenFor(m => m.UserId)
            @Html.HiddenFor(m => m.EmployeeNumber)

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Employee Number</label>
                        <input class="form-control" value="@Model.EmployeeNumber" readonly disabled />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Date Created</label>
                        <input class="form-control" value="@Model.DateCreated.ToString("dd MMM yyyy HH:mm")" readonly disabled />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.FirstName)
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "Enter first name" })
                        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.LastName)
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Enter last name" })
                        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter email", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.PhoneNumber)
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "Enter phone number" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Status</label>
                        @if (Model.IsActive)
                        {
                            <span class="badge badge-success" style="padding: 8px 15px; font-size: 0.9rem;">
                                <i class="fa fa-check-circle"></i> Active
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-danger" style="padding: 8px 15px; font-size: 0.9rem;">
                                <i class="fa fa-times-circle"></i> Disabled
                            </span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>User ID</label>
                        <input class="form-control" value="@Model.UserId" readonly disabled />
                    </div>
                </div>
            </div>

            <hr />

            <div class="row">
                <div class="col-md-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i>
                        Update Profile
                    </button>
                    <a href="@Url.Action("ChangePassword", "Manage")" class="btn btn-secondary">
                        <i class="fa fa-key"></i>
                        Change Password
                    </a>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i>
                        Back
                    </a>
                </div>
            </div>
        }

    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
