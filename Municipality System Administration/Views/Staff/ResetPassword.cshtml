@model Municipality_System_Administration.Models.Staff

@{
    ViewBag.Title = "Reset Staff Password";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      rel="stylesheet" />

<style>

    body {
        background: #f4f7fb;
    }

    .page-header {
        background: linear-gradient(135deg,#0f4c81,#1f7a8c);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-custom {
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,.08);
    }

    .user-info {
        background: #f4f7fb;
        border-left: 4px solid #0f4c81;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 25px;
    }

    .password-icon {
        color: #0f4c81;
    }
</style>

<div class="container mt-4">

    <div class="page-header">

        <h2>
            <i class="fa fa-key"></i>
            Reset Staff Password
        </h2>

        <p>
            Change the system login password for this employee.
        </p>

    </div>

    <div class="card-custom">

        <div class="user-info">

            <h5>
                <i class="fa fa-user"></i>
                Employee Information
            </h5>

            <hr />

            <p>
                <strong>Employee Number:</strong>
                @Model.EmployeeNumber
            </p>

            <p>
                <strong>Name:</strong>
                @Model.FullName
            </p>

            <p>
                <strong>Email:</strong>
                @Model.Email
            </p>

        </div>

        @using (Html.BeginForm("ResetPassword",
                               "Staff",
                               FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.StaffId)

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "alert alert-danger" })

            <div class="form-group mb-3">

                <label>
                    <i class="fa fa-lock password-icon"></i>
                    New Password
                </label>

                <input type="password"
                       name="newPassword"
                       class="form-control"
                       placeholder="Enter new password"
                       required />

                @Html.ValidationMessage(
                    "newPassword",
                    "",
                    new { @class = "text-danger" })

            </div>

            <div class="form-group mb-4">

                <label>
                    <i class="fa fa-lock password-icon"></i>
                    Confirm New Password
                </label>

                <input type="password"
                       name="confirmPassword"
                       class="form-control"
                       placeholder="Confirm new password"
                       required />

                @Html.ValidationMessage(
                    "confirmPassword",
                    "",
                    new { @class = "text-danger" })

            </div>

            <div class="alert alert-warning">

                <i class="fa fa-triangle-exclamation"></i>

                <strong>Security Notice</strong>

                <br />

                The employee will need to use this new password
                when signing into the Municipality Administration System.

            </div>

            <button type="submit"
                    class="btn btn-success">

                <i class="fa fa-key"></i>
                Reset Password

            </button>

            <a href="@Url.Action("Index", "Staff")"
               class="btn btn-secondary">

                <i class="fa fa-arrow-left"></i>
                Cancel

            </a>
        }

    </div>

</div>
