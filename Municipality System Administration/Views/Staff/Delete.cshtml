@model Municipality_System_Administration.Models.Staff

@{
    ViewBag.Title = "Delete Staff Member";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .header {
        background: linear-gradient(135deg,#dc3545,#c0392b);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-custom {
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,.08);
    }

    .detail-label {
        font-weight: 600;
        color: #0f4c81;
        margin-bottom: 5px;
    }

    .detail-value {
        font-size: 1.1rem;
        padding: 8px 12px;
        background: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .warning-box {
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .status-badge {
        padding: 8px 20px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 1rem;
    }

    .status-active {
        background: #198754;
        color: white;
    }

    .status-disabled {
        background: #dc3545;
        color: white;
    }

    .employee-badge {
        background: #e9ecef;
        padding: 8px 15px;
        border-radius: 20px;
        font-weight: 600;
        color: #0f4c81;
    }
</style>

<div class="container mt-4">

    <div class="header">
        <h2>
            <i class="fa fa-user-times"></i>
            Delete Staff Member
        </h2>
        <p>This action cannot be undone. Please confirm deletion.</p>
    </div>

    <div class="card-custom">

        <div class="warning-box">
            <h4 class="text-danger">
                <i class="fa fa-exclamation-triangle"></i>
                Are you sure you want to delete this staff member?
            </h4>
            <p class="mb-0">
                <strong>Warning:</strong> This will permanently delete the staff record AND the associated user account.
                All related data will be removed from the system.
            </p>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="detail-label">
                    <i class="fa fa-id-badge"></i> Employee Number
                </div>
                <div class="detail-value">
                    <strong>@Model.EmployeeNumber</strong>
                </div>

                <div class="detail-label">
                    <i class="fa fa-user"></i> Full Name
                </div>
                <div class="detail-value">
                    @Model.FullName
                </div>

                <div class="detail-label">
                    <i class="fa fa-envelope"></i> Email
                </div>
                <div class="detail-value">
                    @Model.Email
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-label">
                    <i class="fa fa-phone"></i> Phone Number
                </div>
                <div class="detail-value">
                    @Model.PhoneNumber
                </div>

                <div class="detail-label">
                    <i class="fa fa-calendar"></i> Date Created
                </div>
                <div class="detail-value">
                    @Model.DateCreated.ToString("dd MMMM yyyy HH:mm")
                </div>

                <div class="detail-label">
                    <i class="fa fa-toggle-on"></i> Current Status
                </div>
                <div class="detail-value">
                    @if (Model.IsActive)
                    {
                        <span class="status-badge status-active">
                            <i class="fa fa-check-circle"></i> Active
                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-disabled">
                            <i class="fa fa-times-circle"></i> Disabled
                        </span>
                    }
                </div>
            </div>
        </div>

        <hr />

        @using (Html.BeginForm("DeleteConfirmed", "Staff", new { id = Model.StaffId }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.StaffId)

            <div class="row">
                <div class="col-md-12">
                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="fa fa-trash"></i>
                        Confirm Delete
                    </button>

                    <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                        <i class="fa fa-arrow-left"></i>
                        Cancel
                    </a>
                </div>
            </div>
        }

    </div>

</div>
