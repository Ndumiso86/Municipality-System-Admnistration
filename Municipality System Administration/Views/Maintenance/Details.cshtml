@model Municipality_System_Administration.Models.Asset

@{
    ViewBag.Title = "Maintenance History";
    var history = ViewBag.MaintenanceHistory as List<Municipality_System_Administration.Models.MaintenanceHistoryItem> ?? new List<Municipality_System_Administration.Models.MaintenanceHistoryItem>();
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .header {
        background: linear-gradient(135deg, #6c757d, #343a40);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-custom {
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
        margin-bottom: 20px;
    }

    .detail-item {
        display: flex;
        padding: 8px 0;
        border-bottom: 1px solid #f1f3f5;
    }

    .detail-label {
        font-weight: 600;
        color: #495057;
        width: 180px;
        flex-shrink: 0;
    }

    .detail-value {
        color: #212529;
        flex: 1;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-ok {
        background: #28a745;
        color: white;
    }

    .status-upcoming {
        background: #ffc107;
        color: #212529;
    }

    .status-overdue {
        background: #dc3545;
        color: white;
    }

    .status-notscheduled {
        background: #6c757d;
        color: white;
    }

    .history-item {
        padding: 12px 15px;
        border-left: 4px solid #0f4c81;
        margin-bottom: 10px;
        background: #f8f9fa;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .history-item:hover {
            background: #e9ecef;
            transform: translateX(5px);
        }

        .history-item .date {
            font-weight: 600;
            color: #0f4c81;
            font-size: 0.9rem;
        }

        .history-item .description {
            color: #495057;
            margin-top: 5px;
        }

        .history-item .type {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-top: 5px;
        }

    .type-recorded {
        background: #28a745;
        color: white;
    }

    .type-scheduled {
        background: #ffc107;
        color: #212529;
    }

    .btn {
        display: inline-block;
        font-weight: 400;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.5rem 1rem;
        font-size: 1rem;
        line-height: 1.5;
        border-radius: 0.25rem;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-secondary {
        color: #fff;
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }

    .btn-primary {
        color: #fff;
        background-color: #007bff;
        border-color: #007bff;
    }

        .btn-primary:hover {
            background-color: #0069d9;
            border-color: #0062cc;
        }

    .btn-success {
        color: #fff;
        background-color: #28a745;
        border-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -15px;
        margin-left: -15px;
    }

    .col-md-6 {
        position: relative;
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        flex: 0 0 50%;
        max-width: 50%;
    }

    .container {
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        margin-right: auto;
        margin-left: auto;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    .mb-3 {
        margin-bottom: 1rem !important;
    }

    hr {
        margin-top: 1rem;
        margin-bottom: 1rem;
        border: 0;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    .text-center {
        text-align: center !important;
    }

    .py-5 {
        padding-top: 3rem !important;
        padding-bottom: 3rem !important;
    }

    .text-muted {
        color: #6c757d !important;
    }

    .no-history {
        color: #6c757d;
        text-align: center;
        padding: 30px 0;
    }

        .no-history i {
            font-size: 3rem;
            margin-bottom: 15px;
            display: block;
        }

    .section-title {
        color: #0f4c81;
        font-weight: 600;
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    .condition-badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
        display: inline-block;
    }

    .condition-new {
        background: #28a745;
        color: white;
    }

    .condition-excellent {
        background: #20c997;
        color: white;
    }

    .condition-good {
        background: #17a2b8;
        color: white;
    }

    .condition-fair {
        background: #ffc107;
        color: #212529;
    }

    .condition-poor {
        background: #fd7e14;
        color: white;
    }

    .condition-damaged {
        background: #dc3545;
        color: white;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 15px;
    }

    @@media (max-width: 768px) {
        .col-md-6 {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .detail-item {
            flex-direction: column;
        }

        .detail-label {
            width: 100%;
            margin-bottom: 5px;
        }

        .action-buttons {
            flex-direction: column;
        }

            .action-buttons .btn {
                width: 100%;
            }
    }
</style>

<div class="container mt-4">

    <div class="header">
        <h2>
            <i class="fa fa-history"></i>
            Maintenance History
        </h2>
        <p>Complete maintenance history for asset: <strong>@Model.AssetNumber</strong></p>
    </div>

    <div class="card-custom">
        <h5 class="section-title"><i class="fa fa-box"></i> Asset Information</h5>
        <div class="row">
            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Asset Number</span>
                    <span class="detail-value"><strong>@Model.AssetNumber</strong></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Asset Name</span>
                    <span class="detail-value">@Model.AssetName</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Category</span>
                    <span class="detail-value">@Model.Category</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Brand/Model</span>
                    <span class="detail-value">@Model.Brand @(!string.IsNullOrEmpty(Model.Model) ? "/ " + Model.Model : "")</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Condition</span>
                    <span class="detail-value">
                        @{
                            string conditionClass = "condition-" + (Model.Condition?.ToLower() ?? "good");
                        }
                        <span class="condition-badge @conditionClass">
                            @Model.Condition
                        </span>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Status</span>
                    <span class="detail-value">@Model.Status</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Last Maintenance</span>
                    <span class="detail-value">@(Model.LastMaintenanceDate?.ToString("dd MMM yyyy") ?? "Never")</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Next Maintenance</span>
                    <span class="detail-value">
                        @if (Model.NextMaintenanceDate.HasValue)
                        {
                            var status = "OK";
                            if (Model.NextMaintenanceDate.Value.Date < DateTime.Now.Date)
                            {
                                status = "Overdue";
                            }
                            else if (Model.NextMaintenanceDate.Value.Date <= DateTime.Now.AddDays(30))
                            {
                                status = "Upcoming";
                            }
                            string statusClass = "status-" + status.ToLower();
                            <span>
                                @Model.NextMaintenanceDate.Value.ToString("dd MMM yyyy")
                                <span class="status-badge @statusClass">
                                    <i class="fa fa-circle"></i> @status
                                </span>
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">Not Scheduled</span>
                        }
                    </span>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.MaintenanceNotes))
        {
            <div class="detail-item">
                <span class="detail-label">Maintenance Notes</span>
                <span class="detail-value">@Model.MaintenanceNotes</span>
            </div>
        }
    </div>

    <div class="card-custom">
        <h5 class="section-title"><i class="fa fa-clock"></i> Maintenance History</h5>

        @if (history.Any())
        {
            <div class="history-list">
                @foreach (var item in history)
                {
                    <div class="history-item">
                        <div class="date">
                            <i class="fa fa-calendar-alt"></i>
                            @item.Date.ToString("dd MMM yyyy HH:mm")
                        </div>
                        <div class="description">
                            <i class="fa @(item.Type == "Recorded" ? "fa-clipboard-check text-success" : "fa-calendar-plus text-warning")"></i>
                            @item.Description
                        </div>
                        <span class="type @(item.Type == "Recorded" ? "type-recorded" : "type-scheduled")">
                            @item.Type
                        </span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-history">
                <i class="fa fa-clock"></i>
                <h5>No maintenance history</h5>
                <p>No maintenance records have been recorded for this asset.</p>
            </div>
        }

        @if (history.Any())
        {
            <hr />
            <div class="text-muted" style="font-size: 0.9rem;">
                <i class="fa fa-info-circle"></i>
                Total maintenance records: <strong>@history.Count</strong>
                | Recorded: <strong>@history.Count(h => h.Type == "Recorded")</strong>
                | Scheduled: <strong>@history.Count(h => h.Type == "Scheduled")</strong>
            </div>
        }
    </div>

    <div class="card-custom">
        <div class="action-buttons">
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Back to Maintenance
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("AssetManager"))
            {
                <a href="@Url.Action("Schedule", new { id = Model.AssetId })" class="btn btn-primary">
                    <i class="fa fa-calendar-plus"></i> Schedule Maintenance
                </a>
                <a href="@Url.Action("Record", new { id = Model.AssetId })" class="btn btn-success">
                    <i class="fa fa-clipboard-check"></i> Record Maintenance
                </a>
            }
            <a href="@Url.Action("Details", "Assets", new { id = Model.AssetId })" class="btn btn-info">
                <i class="fa fa-eye"></i> View Asset Details
            </a>
        </div>
    </div>

</div>

