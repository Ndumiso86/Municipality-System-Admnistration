@{
    ViewBag.Title = "Municipality Asset Management";
}

<main>

    <section class="municipality-hero text-white">
        <div class="container py-5">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h1 class="display-4 fw-bold">
                        Municipality Asset Management
                    </h1>

                    <p class="lead mt-3">
                        A centralized platform for managing municipal operations,
                        employees, assets, departments and public services efficiently.
                    </p>

                    @if (User.Identity.IsAuthenticated)
                    {
                        var user = HttpContext.Current.User;
                        string dashboardUrl = "#";

                        if (user.IsInRole("Admin"))
                        {
                            dashboardUrl = Url.Action("AdminDashboard", "Home");
                        }
                        else if (user.IsInRole("MunicipalEmployee"))
                        {
                            dashboardUrl = Url.Action("EmployeeDashboard", "Home");
                        }
                        else if (user.IsInRole("Technician"))
                        {
                            dashboardUrl = Url.Action("TechnicianDashboard", "Home");
                        }
                        else if (user.IsInRole("DepartmentHead"))
                        {
                            dashboardUrl = Url.Action("DepartmentHeadDashboard", "Home");
                        }
                        else if (user.IsInRole("FinanceOfficer"))
                        {
                            dashboardUrl = Url.Action("FinanceDashboard", "Home");
                        }
                        else if (user.IsInRole("AssetManager"))
                        {
                            dashboardUrl = Url.Action("AssetManagerDashboard", "Home");
                        }
                        else
                        {
                            dashboardUrl = Url.Action("Index", "Home");
                        }

                        <a href="@dashboardUrl" class="btn btn-light btn-lg mt-3">
                            <i class="fa fa-arrow-right"></i> Go To Dashboard
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")" class="btn btn-success btn-lg mt-3">
                            <i class="fa fa-sign-in-alt"></i> Staff Login
                        </a>
                    }

                </div>

                <div class="col-md-4 text-center">

                    <div class="government-icon">
                        <i class="fa fa-building fa-5x"></i>
                    </div>

                </div>

            </div>

        </div>
    </section>

    <section class="container py-5">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                System Management Modules
            </h2>

            <p class="text-muted">
                Manage municipality activities from one secure administration portal.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="system-card">
                    <div class="icon-circle">
                        <i class="fa fa-users"></i>
                    </div>
                    <h3>
                        Staff Management
                    </h3>
                    <p>
                        Create, update and manage municipal employees,
                        assign roles and control user access.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="system-card">
                    <div class="icon-circle">
                        <i class="fa fa-building"></i>
                    </div>
                    <h3>
                        Asset Management
                    </h3>
                    <p>
                        Track municipal assets, maintenance records,
                        ownership and availability.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="system-card">
                    <div class="icon-circle">
                        <i class="fa fa-money"></i>
                    </div>
                    <h3>
                        Finance Management
                    </h3>
                    <p>
                        Manage financial operations,
                        budgets and municipal expenses.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="system-card">
                    <div class="icon-circle">
                        <i class="fa fa-sitemap"></i>
                    </div>
                    <h3>
                        Departments
                    </h3>
                    <p>
                        Organise municipal departments and
                        manage department responsibilities.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="system-card">
                    <div class="icon-circle">
                        <i class="fa fa-wrench"></i>
                    </div>
                    <h3>
                        Technical Services
                    </h3>
                    <p>
                        Allow technicians to manage maintenance
                        requests and service tasks.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="system-card">
                    <div class="icon-circle">
                        <i class="fa fa-chart-bar"></i>
                    </div>
                    <h3>
                        Reports & Analytics
                    </h3>
                    <p>
                        Generate reports to support better
                        municipal decision making.
                    </p>
                </div>
            </div>

        </div>

    </section>

    <section class="service-banner">
        <div class="container text-center text-white py-4">

            <h2>
                Building Better Communities Through Technology
            </h2>

            <p>
                Secure • Reliable • Efficient Municipal Administration
            </p>

        </div>
    </section>

</main>

<style>
    .municipality-hero {
        background: linear-gradient(135deg, #003366, #006633);
        min-height: 420px;
        display: flex;
        align-items: center;
    }

    .government-icon {
        background: white;
        color: #006633;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: auto;
    }

    .system-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        height: 100%;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        transition: 0.3s;
    }

        .system-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
        }

    .icon-circle {
        width: 70px;
        height: 70px;
        margin: auto;
        margin-bottom: 20px;
        background: #006633;
        color: white;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 30px;
    }

    .system-card h3 {
        color: #003366;
        font-weight: bold;
    }

    .service-banner {
        background: #003366;
    }

    @@media (max-width: 768px) {
        .government-icon {
            width: 120px;
            height: 120px;
            margin-top: 20px;
        }
    }
</style>