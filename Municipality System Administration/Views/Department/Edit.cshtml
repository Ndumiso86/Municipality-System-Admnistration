@model Municipality_System_Administration.Models.Department

@{
    ViewBag.Title = "Edit Department";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>

    body {
        background: #f4f7fb;
    }

    .page-header {
        background: linear-gradient(135deg,#0f4c81,#1f7a8c);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-custom {
        border: none;
        border-radius: 12px;
        box-shadow: 0 3px 15px rgba(0,0,0,.08);
    }

    .card-header {
        background: #0f4c81;
        color: white;
        font-size: 20px;
        font-weight: 600;
    }

    .form-control {
        border-radius: 8px;
    }

    textarea {
        resize: none;
    }
</style>

<div class="container mt-4">

    <div class="page-header">

        <h2>
            <i class="fa-solid fa-pen-to-square"></i>
            Edit Department
        </h2>

        <p>Update municipality department information.</p>

    </div>

    <div class="card card-custom">

        <div class="card-header">

            Edit Department

        </div>

        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.DepartmentId)

                @Html.HiddenFor(model => model.IsActive)

                <div class="mb-3">

                    @Html.LabelFor(model => model.DepartmentName, new { @class = "form-label fw-bold" })

                    @Html.TextBoxFor(model => model.DepartmentName,
                        new { @class = "form-control" })

                    @Html.ValidationMessageFor(model => model.DepartmentName, "", new { @class = "text-danger" })

                </div>

                <div class="mb-3">

                    @Html.LabelFor(model => model.Description, new { @class = "form-label fw-bold" })

                    @Html.TextAreaFor(model => model.Description,
                        new
                        {
                            @class = "form-control",
                            rows = "5"
                        })

                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })

                </div>

                <div class="mt-4">

                    <button type="submit" class="btn btn-success">

                        <i class="fa fa-save"></i>

                        Save Changes

                    </button>

                    <a href="@Url.Action("Index")" class="btn btn-secondary">

                        <i class="fa fa-arrow-left"></i>

                        Back

                    </a>

                </div>

            }

        </div>

    </div>

</div>

@section Scripts{

    @Scripts.Render("~/bundles/jqueryval")

}
