@model IEnumerable<Municipality_System_Administration.Models.Department>

@{
    ViewBag.Title = "Department Management";

    var totalDepartments = Model.Count();
    var activeDepartments = Model.Count(x => x.IsActive);
    var inactiveDepartments = Model.Count(x => !x.IsActive);
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>

    body {
        background: #f4f7fb;
    }

    .page-header {
        background: linear-gradient(135deg,#0f4c81,#1f7a8c);
        color: white;
        padding: 30px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

        .page-header h2 {
            font-weight: 700;
            margin-bottom: 5px;
        }

    .stat-card {
        border: none;
        border-radius: 12px;
        color: white;
        transition: .3s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

    .stat-icon {
        font-size: 35px;
        opacity: .3;
    }

    .table-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
    }

    .table thead {
        background: #0f4c81;
        color: white;
    }

    .badge-active {
        background: #198754;
        color: white;
        padding: 8px 15px;
        border-radius: 20px;
    }

    .badge-inactive {
        background: #dc3545;
        color: white;
        padding: 8px 15px;
        border-radius: 20px;
    }

    .btn-action {
        margin: 2px;
    }
</style>

<div class="container-fluid">

    <div class="page-header">

        <div class="row">

            <div class="col-md-8">

                <h2>
                    <i class="fa-solid fa-building"></i>
                    Department Management
                </h2>

                <p>
                    Create and manage municipal departments.
                </p>

            </div>

            <div class="col-md-4 text-end">

                <a href="@Url.Action("Create")" class="btn btn-light btn-lg">
                    <i class="fa fa-plus"></i>
                    Add Department
                </a>

            </div>

        </div>

    </div>

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card stat-card bg-primary">

                <div class="card-body">

                    <div class="row">

                        <div class="col-8">

                            <h6>Total Departments</h6>

                            <h2>@totalDepartments</h2>

                        </div>

                        <div class="col-4 text-end">

                            <i class="fa fa-building stat-icon"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card stat-card bg-success">

                <div class="card-body">

                    <div class="row">

                        <div class="col-8">

                            <h6>Active</h6>

                            <h2>@activeDepartments</h2>

                        </div>

                        <div class="col-4 text-end">

                            <i class="fa fa-check-circle stat-icon"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card stat-card bg-danger">

                <div class="card-body">

                    <div class="row">

                        <div class="col-8">

                            <h6>Inactive</h6>

                            <h2>@inactiveDepartments</h2>

                        </div>

                        <div class="col-4 text-end">

                            <i class="fa fa-times-circle stat-icon"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="table-card">

        <div class="row mb-3">

            <div class="col-md-6">

                @using (Html.BeginForm("Index", "Department", FormMethod.Get))
                {
                    <div class="input-group">

                        <input type="text"
                               name="search"
                               class="form-control"
                               placeholder="Search department..." />

                        <button class="btn btn-primary">

                            <i class="fa fa-search"></i>

                        </button>

                    </div>
                }

            </div>

        </div>

        <table class="table table-hover table-bordered align-middle">

            <thead>

                <tr>

                    <th>Department</th>

                    <th>Description</th>

                    <th>Status</th>

                    <th width="260">Actions</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {

                    <tr>

                        <td>

                            <strong>@item.DepartmentName</strong>

                        </td>

                        <td>

                            @item.Description

                        </td>

                        <td>

                            @if (item.IsActive)
                            {
                                <span class="badge-active">

                                    Active

                                </span>
                            }
                            else
                            {
                                <span class="badge-inactive">

                                    Inactive

                                </span>
                            }

                        </td>

                        <td>

                            <a href="@Url.Action("Details",new{id=item.DepartmentId})"
                               class="btn btn-info btn-sm btn-action">

                                <i class="fa fa-eye"></i>

                            </a>

                            <a href="@Url.Action("Edit",new{id=item.DepartmentId})"
                               class="btn btn-warning btn-sm btn-action">

                                <i class="fa fa-edit"></i>

                            </a>

                            @if (item.IsActive)
                            {
                                <a href="@Url.Action("Disable",new{id=item.DepartmentId})"
                                   class="btn btn-secondary btn-sm btn-action">

                                    <i class="fa fa-ban"></i>

                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("Enable",new{id=item.DepartmentId})"
                                   class="btn btn-success btn-sm btn-action">

                                    <i class="fa fa-check"></i>

                                </a>
                            }

                            <a href="@Url.Action("Delete",new{id=item.DepartmentId})"
                               class="btn btn-danger btn-sm btn-action">

                                <i class="fa fa-trash"></i>

                            </a>

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>

</div>

