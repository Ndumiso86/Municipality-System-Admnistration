@using Municipality_System_Administration.Models
@using Microsoft.AspNet.Identity
@using Microsoft.AspNet.Identity.Owin

@{
    var owinContext = HttpContext.Current.GetOwinContext();
    var userManager = owinContext.GetUserManager<ApplicationUserManager>();
    var currentUser = userManager.FindById(User.Identity.GetUserId());

    bool isAdmin = currentUser != null && userManager.IsInRole(currentUser.Id, "Admin");
    bool isAssetManager = currentUser != null && userManager.IsInRole(currentUser.Id, "AssetManager");
    bool isMunicipalEmployee = currentUser != null && userManager.IsInRole(currentUser.Id, "MunicipalEmployee");
    bool isDepartmentHead = currentUser != null && userManager.IsInRole(currentUser.Id, "DepartmentHead");
    bool isTechnician = currentUser != null && userManager.IsInRole(currentUser.Id, "Technician");
    bool isFinanceOfficer = currentUser != null && userManager.IsInRole(currentUser.Id, "FinanceOfficer");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Municipality Asset Management</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        .navbar-green {
            background: linear-gradient(135deg, #0a2e5c 0%, #0d4a2e 100%);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            padding: 8px 0;
            border-bottom: 3px solid #00a651;
            min-height: 70px;
        }

            .navbar-green .navbar-brand {
                color: white !important;
                font-weight: 700;
                font-size: 1.3rem;
                letter-spacing: 0.5px;
                padding: 8px 15px;
                transition: all 0.3s ease;
            }

                .navbar-green .navbar-brand:hover {
                    transform: scale(1.02);
                    color: #9cff57 !important;
                }

                .navbar-green .navbar-brand i {
                    margin-right: 10px;
                    font-size: 1.4rem;
                    color: #9cff57;
                }

            .navbar-green .nav-link {
                color: rgba(255, 255, 255, 0.85) !important;
                font-weight: 500;
                padding: 10px 18px !important;
                border-radius: 8px;
                transition: all 0.3s ease;
                position: relative;
            }

                .navbar-green .nav-link:hover {
                    color: white !important;
                    background: rgba(255, 255, 255, 0.12);
                    transform: translateY(-2px);
                }

                .navbar-green .nav-link.active {
                    color: white !important;
                    background: rgba(156, 255, 87, 0.15);
                }

                    .navbar-green .nav-link.active::after {
                        content: '';
                        position: absolute;
                        bottom: 2px;
                        left: 50%;
                        transform: translateX(-50%);
                        width: 30px;
                        height: 3px;
                        background: #9cff57;
                        border-radius: 2px;
                    }

        .navbar-brand img {
            height: 45px;
            margin-right: 10px;
        }

        .navbar-green .dropdown-menu {
            background: #0a2e5c;
            border: none;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
            padding: 8px 0;
            margin-top: 5px;
            min-width: 220px;
        }

            .navbar-green .dropdown-menu .dropdown-item {
                color: rgba(255, 255, 255, 0.85);
                padding: 10px 24px;
                transition: all 0.3s ease;
                font-weight: 500;
            }

                .navbar-green .dropdown-menu .dropdown-item:hover {
                    background: rgba(156, 255, 87, 0.1);
                    color: white;
                }

                .navbar-green .dropdown-menu .dropdown-item i {
                    margin-right: 10px;
                    width: 20px;
                    color: #9cff57;
                }

            .navbar-green .dropdown-menu .dropdown-divider {
                border-color: rgba(255, 255, 255, 0.08);
            }

        .logout-btn {
            color: rgba(255, 255, 255, 0.9) !important;
            font-weight: 500;
            padding: 8px 20px !important;
            border-radius: 8px;
            transition: all 0.3s ease;
            background: rgba(220, 53, 69, 0.2);
            border: 1px solid rgba(220, 53, 69, 0.3);
            margin-left: 10px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .logout-btn:hover {
                background: rgba(220, 53, 69, 0.4) !important;
                color: white !important;
                transform: translateY(-2px);
                border-color: rgba(220, 53, 69, 0.6);
            }

            .logout-btn i {
                font-size: 1rem;
            }

        .user-info {
            color: white;
            padding: 8px 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .user-info .user-avatar {
                width: 35px;
                height: 35px;
                border-radius: 50%;
                background: rgba(156, 255, 87, 0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px solid #9cff57;
            }

                .user-info .user-avatar i {
                    font-size: 16px;
                    color: #9cff57;
                }

            .user-info .user-name {
                font-weight: 600;
                font-size: 0.9rem;
            }

            .user-info .user-role {
                font-size: 0.7rem;
                opacity: 0.7;
                display: block;
            }

        .role-badge-nav {
            background: rgba(156, 255, 87, 0.15);
            color: #9cff57;
            padding: 2px 12px;
            border-radius: 20px;
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            border: 1px solid rgba(156, 255, 87, 0.2);
        }

        .navbar-nav.ms-auto {
            margin-left: auto !important;
        }

        .navbar-nav .nav-item {
            display: flex;
            align-items: center;
        }

        body {
            background: #f0f2f5;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .body-content {
            min-height: calc(100vh - 280px);
            padding: 20px 0 40px 0;
        }
        .footer {
            background: linear-gradient(135deg, #0a2e5c 0%, #0d4a2e 100%);
            color: rgba(255, 255, 255, 0.85);
            padding: 40px 0 20px 0;
            margin-top: 30px;
            border-top: 3px solid #00a651;
        }

            .footer h5 {
                color: #9cff57;
                font-weight: 700;
                margin-bottom: 15px;
                font-size: 1.1rem;
            }

                .footer h5 i {
                    margin-right: 8px;
                }

            .footer p {
                color: rgba(255, 255, 255, 0.7);
                font-size: 0.9rem;
                line-height: 1.6;
                margin-bottom: 5px;
            }

            .footer a {
                color: rgba(255, 255, 255, 0.7);
                text-decoration: none;
                transition: all 0.3s ease;
            }

                .footer a:hover {
                    color: #9cff57;
                    padding-left: 5px;
                }

            .footer hr {
                border-color: rgba(255, 255, 255, 0.08);
                margin: 20px 0;
            }

            .footer .copyright {
                color: rgba(255, 255, 255, 0.5);
                font-size: 0.85rem;
                text-align: center;
            }

            .footer .social-icons a {
                display: inline-block;
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.05);
                text-align: center;
                line-height: 38px;
                margin-right: 8px;
                transition: all 0.3s ease;
                color: rgba(255, 255, 255, 0.6);
            }

                .footer .social-icons a:hover {
                    background: rgba(156, 255, 87, 0.15);
                    color: #9cff57;
                    transform: translateY(-3px);
                }

        @@media (max-width: 768px) {
            .navbar-green .navbar-brand {
                font-size: 1rem;
            }

            .navbar-green .nav-link {
                padding: 8px 15px !important;
            }

                .navbar-green .nav-link.active::after {
                    display: none;
                }

            .user-info .user-name {
                font-size: 0.8rem;
            }

            .footer {
                text-align: center;
            }

                .footer .social-icons {
                    margin-top: 15px;
                }

            .navbar-brand img {
                height: 35px;
            }

            .logout-btn {
                margin-left: 0;
                margin-top: 5px;
                text-align: center;
                justify-content: center;
            }

            .navbar-nav .dropdown-menu {
                background: rgba(0, 0, 0, 0.2);
            }

            .navbar-nav .nav-item {
                display: block;
            }
        }

        @@keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .navbar-green {
            animation: fadeInDown 0.5s ease;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f0f2f5;
        }

        ::-webkit-scrollbar-thumb {
            background: #0a2e5c;
            border-radius: 10px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #0d4a2e;
            }
    </style>

</head>
<body>

    <nav class="navbar navbar-expand-sm navbar-dark navbar-green">
        <div class="container">

            @if (isAdmin)
            {
                <a class="navbar-brand" href="@Url.Action("Dashboard", "Admin")">
                    <i class="fa-solid fa-building-columns"></i>
                    Municipality Admin
                </a>
            }
            else if (isAssetManager)
            {
                <a class="navbar-brand" href="@Url.Action("Dashboard", "AssetManager")">
                    <i class="fa-solid fa-box"></i>
                    Asset Manager
                </a>
            }
            else if (isMunicipalEmployee)
            {
                <a class="navbar-brand" href="@Url.Action("Dashboard", "Employee")">
                    <i class="fa-solid fa-user"></i>
                    Municipal Employee
                </a>
            }
            else if (isDepartmentHead)
            {
                <a class="navbar-brand" href="@Url.Action("Dashboard", "DepartmentHead")">
                    <i class="fa-solid fa-sitemap"></i>
                    Department Head
                </a>
            }
            else if (isTechnician)
            {
                <a class="navbar-brand" href="@Url.Action("Dashboard", "Technician")">
                    <i class="fa-solid fa-wrench"></i>
                    Technician
                </a>
            }
            else if (isFinanceOfficer)
            {
                <a class="navbar-brand" href="@Url.Action("Dashboard", "Finance")">
                    <i class="fa-solid fa-money-bill"></i>
                    Finance Officer
                </a>
            }
            else
            {
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    <i class="fa-solid fa-building"></i>
                    Municipality System
                </a>
            }

            <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse">
                <ul class="navbar-nav flex-grow-1">

                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Dashboard", "Dashboard", "Admin", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Staff", "Index", "Staff", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Assets", "Index", "Assets", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Departments", "Index", "Department", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Finance", "Dashboard", "Finance", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Reports", "Index", "Reports", null, new { @class = "nav-link" })
                        </li>

                    }
                    else if (isAssetManager)
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Dashboard", "Dashboard", "AssetManager", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("All Assets", "Index", "Assets", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Add Asset", "Create", "Assets", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Categories", "Categories", "Assets", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Reports", "Index", "Reports", null, new { @class = "nav-link" })
                        </li>
                    }
                    else if (isMunicipalEmployee)
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Dashboard", "Dashboard", "Employee", null, new { @class = "nav-link" })
                        </li>
                        <li>@Html.ActionLink("My Assets", "MyAssets", "Assets")</li>
                        <li class="nav-item">
                            @Html.ActionLink("My Tasks", "MyTasks", "WorkOrders", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("New Request", "Create", "WorkOrders", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("My Profile", "MyProfile", "Staff", null, new { @class = "nav-link" })
                        </li>
                    }
                    else if (isDepartmentHead)
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Dashboard", "Dashboard", "DepartmentHead", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Department Staff", "DepartmentStaff", "Staff", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Work Orders", "Index", "WorkOrders", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Reports", "Reports", "Department", null, new { @class = "nav-link" })
                        </li>
                    }
                    else if (isTechnician)
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Dashboard", "Dashboard", "Technician", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Repair Queue", "RepairQueue", "Technician", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("History", "RepairHistory", "Technician", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("My Profile", "MyProfile", "Staff", null, new { @class = "nav-link" })
                        </li>
                        <li>
                            @Html.ActionLink("My Assets", "MyAssets", "Assets")
                        </li>
                    }
                    else if (isFinanceOfficer)
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Dashboard", "Dashboard", "Finance", null, new { @class = "nav-link" })
                        </li>
                        <li>@Html.ActionLink("My Assets", "MyAssets", "Assets")</li>
                        <li class="nav-item">
                            @Html.ActionLink("Transactions", "Index", "Finance", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Budget", "Budget", "Finance", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Reports", "Reports", "Finance", null, new { @class = "nav-link" })
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Home", "Index", "Home", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("About", "About", "Home", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Contact", "Contact", "Home", null, new { @class = "nav-link" })
                        </li>
                    }

                </ul>

                <ul class="navbar-nav">
                    @if (Request.IsAuthenticated)
                    {
                        var roles = userManager.GetRoles(currentUser?.Id);
                        var roleName = roles.FirstOrDefault() ?? "User";

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-info">
                                    <div class="user-avatar">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                    <div>
                                        <span class="user-name">@User.Identity.Name</span>
                                        <span class="user-role">
                                            <span class="role-badge-nav">@roleName</span>
                                        </span>
                                    </div>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("MyProfile", "Staff")">
                                        <i class="fa-solid fa-user"></i> My Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("ChangePassword", "Manage")">
                                        <i class="fa-solid fa-key"></i> Change Password
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Notifications", "Notifications")">
                                        <i class="fa-solid fa-bell"></i> Notifications
                                        <span class="badge bg-danger rounded-pill ms-2">3</span>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
                            {
                                @Html.AntiForgeryToken()
                                <a href="#" class="nav-link logout-btn" onclick="document.getElementById('logoutForm').submit(); return false;">
                                    <i class="fa-solid fa-sign-out-alt"></i> Logout
                                </a>
                            }
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Account")">
                                <i class="fa-solid fa-sign-in-alt"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Register", "Account")">
                                <i class="fa-solid fa-user-plus"></i> Register
                            </a>
                        </li>
                    }
                </ul>
            </div>

        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
    </div>

    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5><i class="fa-solid fa-building"></i> Municipality System</h5>
                    <p>Digital platform for managing municipal services, assets, and operations efficiently.</p>
                    <div class="social-icons">
                        <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="#"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>
                <div class="col-md-4">
                    <h5><i class="fa-solid fa-cogs"></i> Services</h5>
                    <p><i class="fa-solid fa-boxes"></i> <a href="#">Asset Management</a></p>
                    <p><i class="fa-solid fa-users"></i> <a href="#">Staff Administration</a></p>
                    <p><i class="fa-solid fa-coins"></i> <a href="#">Finance Management</a></p>
                    <p><i class="fa-solid fa-tools"></i> <a href="#">Technical Services</a></p>
                </div>
                <div class="col-md-4">
                    <h5><i class="fa-solid fa-headset"></i> Support</h5>
                    <p><i class="fa-solid fa-envelope"></i> <a href="mailto:support@municipality.gov.za">support@municipality.gov.za</a></p>
                    <p><i class="fa-solid fa-phone"></i> <a href="tel:+27123456789">+27 12 345 6789</a></p>
                    <p><i class="fa-solid fa-clock"></i> Mon - Fri: 08:00 - 16:30</p>
                    <p><i class="fa-solid fa-shield-alt"></i> Secure Government Portal</p>
                </div>
            </div>
            <hr />
            <div class="copyright">
                &copy; @DateTime.Now.Year Municipality Asset Management System. All rights reserved.
                <br />
                <span style="font-size: 0.75rem; opacity: 0.6;">Version 2.0 | Built with <i class="fa-solid fa-heart" style="color: #9cff57;"></i> for better communities</span>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script>
        $(document).ready(function () {
            var currentUrl = window.location.pathname.toLowerCase();
            $('.navbar-nav .nav-link').each(function () {
                var linkUrl = $(this).attr('href');
                if (linkUrl) {
                    var linkLower = linkUrl.toLowerCase();
                    if (currentUrl.indexOf(linkLower) !== -1 && linkLower !== '/') {
                        $(this).addClass('active');
                    }
                }
            });

            $('.footer a[href^="#"]').on('click', function (e) {
                e.preventDefault();
                var target = $(this.getAttribute('href'));
                if (target.length) {
                    $('html, body').animate({
                        scrollTop: target.offset().top - 100
                    }, 600);
                }
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('.dropdown').length) {
                    $('.dropdown-menu').removeClass('show');
                }
            });

            $('.logout-btn').on('click', function (e) {
                e.preventDefault();
                $('#logoutForm').submit();
            });
        });
    </script>

</body>
</html>