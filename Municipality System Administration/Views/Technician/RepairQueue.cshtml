@using Municipality_System_Administration.Models
@model IEnumerable<Asset>

@{
    ViewBag.Title = "Repair Queue";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .page-header {
        background: linear-gradient(135deg, #28a745, #1e7e34);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-box {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
    }

    .table thead {
        background: #0f4c81;
        color: white;
    }

        .table thead th {
            color: white;
            padding: 12px 15px;
        }

    .table tbody td {
        padding: 12px 15px;
        vertical-align: middle;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-approved {
        background: #28a745;
        color: white;
    }

    .status-inprogress {
        background: #ffc107;
        color: #212529;
    }

    .action-buttons {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

        .action-buttons .btn {
            margin: 2px;
            min-width: 32px;
            cursor: pointer;
        }

    .btn-sm {
        padding: 4px 10px;
        font-size: 12px;
        line-height: 1.5;
        border-radius: 4px;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 30px;
    }

        .btn-sm i {
            font-size: 13px;
        }

    .btn-primary {
        color: #fff;
        background-color: #007bff;
        border-color: #007bff;
    }

        .btn-primary:hover {
            background-color: #0069d9;
            border-color: #0062cc;
        }

    .btn-success {
        color: #fff;
        background-color: #28a745;
        border-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

    .btn-info {
        color: #fff;
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

        .btn-info:hover {
            background-color: #138496;
            border-color: #117a8b;
        }

    .alert {
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        border: 1px solid transparent;
        border-radius: 0.25rem;
    }

    .alert-success {
        color: #155724;
        background-color: #d4edda;
        border-color: #c3e6cb;
    }

    .alert-danger {
        color: #721c24;
        background-color: #f8d7da;
        border-color: #f5c6cb;
    }

    .alert-dismissible {
        padding-right: 4rem;
    }

    .close {
        float: right;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        color: #000;
        text-shadow: 0 1px 0 #fff;
        opacity: .5;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
    }

    .container {
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        margin-right: auto;
        margin-left: auto;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    .mb-3 {
        margin-bottom: 1rem !important;
    }

    .text-center {
        text-align: center !important;
    }

    .py-5 {
        padding-top: 3rem !important;
        padding-bottom: 3rem !important;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .btn {
        display: inline-block;
        font-weight: 400;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        line-height: 1.5;
        border-radius: 0.25rem;
        transition: color .15s ease-in-out, background-color .15s ease-in-out, border-color .15s ease-in-out, box-shadow .15s ease-in-out;
        text-decoration: none;
    }

    .btn-secondary {
        color: #fff;
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }

    .badge-secondary {
        background: #6c757d;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .approved-badge {
        background: #28a745;
        color: white;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
        display: inline-block;
        margin-left: 5px;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }
    }

    .search-box {
        max-width: 300px;
        display: inline-block;
        float: right;
    }

    .clearfix::after {
        content: "";
        clear: both;
        display: table;
    }

    .form-control {
        display: block;
        width: 100%;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        line-height: 1.5;
        color: #495057;
        background-color: #fff;
        background-clip: padding-box;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        transition: border-color .15s ease-in-out,box-shadow .15s ease-in-out;
    }

    .float-left {
        float: left !important;
    }

    .float-right {
        float: right !important;
    }

    .stats-summary {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

        .stats-summary span {
            margin-right: 25px;
        }

    .refresh-btn {
        background: #17a2b8;
        color: white;
        border: none;
        padding: 6px 15px;
        border-radius: 4px;
        cursor: pointer;
    }

        .refresh-btn:hover {
            background: #138496;
        }

    @@media (max-width: 768px) {
        .table-responsive {
            overflow-x: auto;
        }

        .action-buttons .btn {
            min-width: 28px;
            height: 28px;
            padding: 3px 8px;
        }

            .action-buttons .btn i {
                font-size: 11px;
            }

        .search-box {
            max-width: 100%;
            float: none;
            margin-top: 10px;
        }

        .float-right {
            float: none !important;
        }

        .clearfix {
            text-align: center;
        }

        .stats-summary span {
            display: block;
            margin-bottom: 5px;
        }
    }
</style>

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i>
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle"></i>
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="page-header">
        <h2>
            <i class="fa fa-tools"></i>
            Repair Queue
            <span class="badge" style="background: rgba(255,255,255,0.2); color: white; padding: 8px 15px; border-radius: 20px;">
                <i class="fa fa-list"></i> @Model.Count() Repairs
            </span>
        </h2>
        <p>View and manage your approved repair tasks.</p>
    </div>

    <div class="card-box">

        <div class="clearfix mb-3">
            <div class="float-left">
                <a href="@Url.Action("Dashboard")" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Back to Dashboard
                </a>
                <a href="@Url.Action("RepairHistory")" class="btn btn-info">
                    <i class="fa fa-history"></i> View History
                </a>
                <button onclick="location.reload();" class="btn refresh-btn">
                    <i class="fa fa-sync"></i> Refresh
                </button>
            </div>
            <div class="float-right">
                <input type="text" id="searchInput" class="form-control search-box" placeholder="Search repairs..." />
            </div>
        </div>

        <div class="stats-summary">
            <span><strong>Total in Queue:</strong> @Model.Count()</span>
            <span><strong>Ready to Start:</strong> @Model.Count(a => a.RepairStatus == "Approved")</span>
            <span><strong>In Progress:</strong> @Model.Count(a => a.RepairStatus == "In Progress")</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered" id="repairTable">
                <thead>
                    <tr>
                        <th>Asset No</th>
                        <th>Asset Name</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Approved Date</th>
                        <th>Requested Date</th>
                        <th style="min-width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string statusClass = "status-" + (item.RepairStatus?.ToLower() ?? "approved");

                            <tr>
                                <td>
                                    <strong>@item.AssetNumber</strong>
                                </td>
                                <td>
                                    <i class="fa fa-box"></i>
                                    @item.AssetName
                                    @if (item.RepairStatus == "Approved")
                                    {
                                        <span class="approved-badge">
                                            <i class="fa fa-check-circle"></i> Ready
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge-secondary">@item.Category</span>
                                </td>
                                <td>
                                    <span class="status-badge @statusClass">
                                        <i class="fa fa-circle"></i>
                                        @item.RepairStatus
                                    </span>
                                </td>
                                <td>
                                    @item.RepairRequestDate?.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    @item.RepairRequestDate?.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="@Url.Action("AssetDetails", "Technician", new { id = item.AssetId })"
                                           class="btn btn-info btn-sm"
                                           title="View Details">
                                            <i class="fa fa-eye"></i>
                                        </a>

                                        @if (item.RepairStatus == "Approved")
                                        {
                                            <a href="@Url.Action("StartRepair", "Technician", new { id = item.AssetId })"
                                               class="btn btn-primary btn-sm"
                                               title="Start Repair">
                                                <i class="fa fa-play"></i>
                                            </a>
                                        }
                                        else if (item.RepairStatus == "In Progress")
                                        {
                                            <a href="@Url.Action("CompleteRepair", "Technician", new { id = item.AssetId })"
                                               class="btn btn-success btn-sm"
                                               title="Complete Repair">
                                                <i class="fa fa-check"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="text-center py-5">
                                    <i class="fa fa-check-circle fa-3x text-success mb-3"></i>
                                    <h4>No repairs in queue</h4>
                                    <p class="text-muted">You have no approved repairs assigned to you.</p>
                                    <p class="text-muted">Once the Department Head approves a repair, it will appear here.</p>
                                    <button onclick="location.reload();" class="btn btn-info mt-3">
                                        <i class="fa fa-sync"></i> Check for New Repairs
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#searchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('#repairTable tbody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            setInterval(function () {
                location.reload();
            }, 30000);
        });
    </script>
}
