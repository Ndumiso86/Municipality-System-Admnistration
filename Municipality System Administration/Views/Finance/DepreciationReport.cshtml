@using Municipality_System_Administration.Models
@using Municipality_System_Administration.Services
@model IEnumerable<Municipality_System_Administration.Models.Asset>

@{
    ViewBag.Title = "Depreciation Report";
    var summary = ViewBag.Summary as DepreciationSummary;
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .page-header {
        background: linear-gradient(135deg, #8e44ad, #6c3483);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-custom {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
        margin-bottom: 20px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
        border-left: 4px solid #8e44ad;
        margin-bottom: 20px;
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: bold;
        color: #8e44ad;
    }

    .stat-label {
        color: #6c757d;
        font-size: 0.9rem;
        margin-top: 5px;
    }

    .table thead {
        background: #8e44ad;
        color: white;
    }

        .table thead th {
            color: white;
            padding: 12px 15px;
        }

    .table tbody td {
        padding: 12px 15px;
        vertical-align: middle;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-active {
        background: #28a745;
        color: white;
    }

    .status-fullydepreciated {
        background: #8e44ad;
        color: white;
    }

    .status-disposed {
        background: #dc3545;
        color: white;
    }

    .badge-secondary {
        background: #6c757d;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .text-muted {
        color: #6c757d !important;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -15px;
        margin-left: -15px;
    }

    .col-md-2 {
        position: relative;
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        flex: 0 0 16.666667%;
        max-width: 16.666667%;
    }

    .container {
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        margin-right: auto;
        margin-left: auto;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    .mb-4 {
        margin-bottom: 1.5rem !important;
    }

    .text-center {
        text-align: center !important;
    }

    .btn {
        display: inline-block;
        font-weight: 400;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        border-radius: 0.25rem;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-primary {
        color: #fff;
        background-color: #8e44ad;
        border-color: #8e44ad;
    }

        .btn-primary:hover {
            background-color: #6c3483;
            border-color: #6c3483;
        }

    .btn-secondary {
        color: #fff;
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }

    .btn-info {
        color: #fff;
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

        .btn-info:hover {
            background-color: #138496;
            border-color: #117a8b;
        }

    .btn-sm {
        padding: 4px 10px;
        font-size: 12px;
        border-radius: 4px;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 30px;
    }

        .btn-sm i {
            font-size: 13px;
        }

    .alert {
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        border: 1px solid transparent;
        border-radius: 0.25rem;
    }

    .alert-success {
        color: #155724;
        background-color: #d4edda;
        border-color: #c3e6cb;
    }

    .alert-warning {
        color: #856404;
        background-color: #fff3cd;
        border-color: #ffeeba;
    }

    .alert-dismissible {
        padding-right: 4rem;
    }

    .close {
        float: right;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        color: #000;
        opacity: .5;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
    }

    .action-buttons {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

    .depreciation-method {
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
        display: inline-block;
    }

    .method-sl {
        background: #3498db;
        color: white;
    }

    .method-db {
        background: #e67e22;
        color: white;
    }

    .method-dd {
        background: #e74c3c;
        color: white;
    }

    .method-none {
        background: #95a5a6;
        color: white;
    }

    .no-data {
        text-align: center;
        padding: 30px 0;
        color: #6c757d;
    }

        .no-data i {
            font-size: 2.5rem;
            margin-bottom: 10px;
            display: block;
        }

    .method-stat {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        border: 1px solid #e9ecef;
        margin-bottom: 10px;
    }

        .method-stat .count {
            font-size: 1.8rem;
            font-weight: bold;
            color: #8e44ad;
        }

        .method-stat .method {
            font-weight: 600;
            color: #495057;
        }

        .method-stat .total {
            color: #6c757d;
            font-size: 0.9rem;
        }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        font-weight: 600;
        margin-bottom: 6px;
    }

    .form-control {
        display: block;
        width: 100%;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
    }

    @@media (max-width: 768px) {
        .col-md-2 {
            flex: 0 0 50%;
            max-width: 50%;
            margin-bottom: 15px;
        }

        .table-responsive {
            overflow-x: auto;
        }

        .action-buttons .btn {
            min-width: 28px;
            height: 28px;
            padding: 3px 8px;
        }

            .action-buttons .btn i {
                font-size: 11px;
            }
    }
</style>

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert">×</button>
        </div>
    }

    <div class="page-header">
        <h2>
            <i class="fa fa-chart-line"></i>
            Depreciation Report
        </h2>
        <p>View asset depreciation status and calculations.</p>
    </div>

    <!-- Summary Statistics -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="stat-card" style="border-left-color: #8e44ad;">
                <div class="stat-number">@(summary?.TotalAssets ?? 0)</div>
                <div class="stat-label"><i class="fa fa-boxes"></i> Total Assets</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card" style="border-left-color: #2980b9;">
                <div class="stat-number">@(summary?.AssetsWithDepreciation ?? 0)</div>
                <div class="stat-label"><i class="fa fa-calculator"></i> With Depreciation</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card" style="border-left-color: #2ecc71;">
                <div class="stat-number">@(summary?.TotalCurrentBookValue.ToString("C0") ?? "0")</div>
                <div class="stat-label"><i class="fa fa-book"></i> Total Book Value</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card" style="border-left-color: #e74c3c;">
                <div class="stat-number">@(summary?.TotalAccumulatedDepreciation.ToString("C0") ?? "0")</div>
                <div class="stat-label"><i class="fa fa-percent"></i> Accumulated Depreciation</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card" style="border-left-color: #f1c40f;">
                <div class="stat-number">@(summary?.FullyDepreciatedAssets ?? 0)</div>
                <div class="stat-label"><i class="fa fa-check-circle"></i> Fully Depreciated</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card" style="border-left-color: #e67e22;">
                <div class="stat-number">@Model.Count()</div>
                <div class="stat-label"><i class="fa fa-list"></i> Showing Assets</div>
            </div>
        </div>
    </div>

    <!-- Depreciation Methods Summary -->
    @if (summary?.AssetsByMethod != null && summary.AssetsByMethod.Any())
    {
        <div class="card-custom">
            <h5><i class="fa fa-chart-pie"></i> Depreciation Methods</h5>
            <hr />
            <div class="row">
                @foreach (var method in summary.AssetsByMethod)
                {
                    <div class="col-md-3">
                        <div class="method-stat">
                            <div class="count">@method.Count</div>
                            <div class="method">@method.Method</div>
                            <div class="total">Book Value: @method.TotalBookValue.ToString("C0")</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Process Depreciation Button -->
    <div class="card-custom">
        <h5><i class="fa fa-play"></i> Process Depreciation</h5>
        <hr />
        <p class="text-muted">Calculate depreciation for all active assets.</p>
        @using (Html.BeginForm("ProcessDepreciation", "Finance", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="asOfDate">As of Date</label>
                        <input type="date" name="asOfDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="col-md-8" style="padding-top: 30px;">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fa fa-calculator"></i> Process Depreciation
                    </button>
                    <small class="text-muted">This will update all asset depreciation values.</small>
                </div>
            </div>
        }
    </div>

    <!-- Assets List -->
    <div class="card-custom">
        <h5><i class="fa fa-boxes"></i> Asset Depreciation Details</h5>
        <hr />
        <div class="table-responsive">
            <table class="table table-hover table-bordered">
                <thead>
                    <tr>
                        <th>Asset No</th>
                        <th>Asset Name</th>
                        <th>Purchase Price</th>
                        <th>Method</th>
                        <th>Rate</th>
                        <th>Useful Life</th>
                        <th>Salvage Value</th>
                        <th>Book Value</th>
                        <th>Accumulated Depreciation</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            // Determine method class using if/else, not inline ternary
                            string methodClass = "method-none";
                            if (item.DepreciationMethod == "StraightLine")
                            {
                                methodClass = "method-sl";
                            }
                            else if (item.DepreciationMethod == "DecliningBalance")
                            {
                                methodClass = "method-db";
                            }
                            else if (item.DepreciationMethod == "DoubleDeclining")
                            {
                                methodClass = "method-dd";
                            }

                            string statusClass = "status-active";
                            if (item.DepreciationStatus == "FullyDepreciated")
                            {
                                statusClass = "status-fullydepreciated";
                            }
                            else if (item.DepreciationStatus == "Disposed")
                            {
                                statusClass = "status-disposed";
                            }

                            <tr>
                                <td><strong>@item.AssetNumber</strong></td>
                                <td><i class="fa fa-box"></i> @item.AssetName</td>
                                <td>@item.PurchasePrice?.ToString("C2")</td>
                                <td>
                                    <span class="depreciation-method @methodClass">
                                        @(item.DepreciationMethod ?? "None")
                                    </span>
                                </td>
                                <td>@item.DepreciationRate?.ToString("P0")</td>
                                <td>@(item.UsefulLife?.ToString() + " yrs")</td>
                                <td>@item.SalvageValue?.ToString("C2")</td>
                                <td><strong>@item.CurrentBookValue?.ToString("C2")</strong></td>
                                <td>@item.AccumulatedDepreciation?.ToString("C2")</td>
                                <td>
                                    <span class="status-badge @statusClass">
                                        <i class="fa fa-circle"></i>
                                        @(item.DepreciationStatus ?? "Active")
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="@Url.Action("AssetDepreciation", "Finance", new { id = item.AssetId })"
                                           class="btn btn-info btn-sm" title="View Details">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11">
                                <div class="no-data">
                                    <i class="fa fa-boxes text-muted"></i>
                                    <p class="text-muted">No assets found.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Back Button -->
    <div class="row">
        <div class="col-md-12">
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

</div>