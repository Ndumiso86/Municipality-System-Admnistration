@model Municipality_System_Administration.Models.Asset
@using Municipality_System_Administration.Models

@{
    ViewBag.Title = "Delete Asset";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .header {
        background: linear-gradient(135deg, #dc3545, #c82333);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-custom {
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
    }

    .warning-box {
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .detail-item {
        display: flex;
        padding: 8px 0;
        border-bottom: 1px solid #f1f3f5;
    }

    .detail-label {
        font-weight: 600;
        color: #495057;
        width: 180px;
        flex-shrink: 0;
    }

    .detail-value {
        color: #212529;
        flex: 1;
    }

    .status-badge {
        padding: 6px 15px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-available {
        background: #28a745;
        color: white;
    }

    .status-assigned {
        background: #007bff;
        color: white;
    }

    .status-maintenance {
        background: #ffc107;
        color: #212529;
    }

    .status-repair {
        background: #fd7e14;
        color: white;
    }

    .status-disposed {
        background: #dc3545;
        color: white;
    }

    .status-lost {
        background: #6c757d;
        color: white;
    }

    .status-stolen {
        background: #343a40;
        color: white;
    }

    .btn {
        display: inline-block;
        font-weight: 400;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.5rem 1rem;
        font-size: 1rem;
        line-height: 1.5;
        border-radius: 0.25rem;
        transition: color .15s ease-in-out, background-color .15s ease-in-out, border-color .15s ease-in-out, box-shadow .15s ease-in-out;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-danger {
        color: #fff;
        background-color: #dc3545;
        border-color: #dc3545;
    }

        .btn-danger:hover {
            background-color: #c82333;
            border-color: #bd2130;
        }

    .btn-secondary {
        color: #fff;
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }

    .btn-lg {
        padding: 0.5rem 1rem;
        font-size: 1.25rem;
        line-height: 1.5;
        border-radius: 0.3rem;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -15px;
        margin-left: -15px;
    }

    .col-md-6, .col-md-12 {
        position: relative;
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
    }

    .col-md-6 {
        flex: 0 0 50%;
        max-width: 50%;
    }

    .col-md-12 {
        flex: 0 0 100%;
        max-width: 100%;
    }

    .container {
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        margin-right: auto;
        margin-left: auto;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    hr {
        margin-top: 1rem;
        margin-bottom: 1rem;
        border: 0;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    .text-center {
        text-align: center !important;
    }

    .text-danger {
        color: #dc3545 !important;
    }

    .mb-0 {
        margin-bottom: 0 !important;
    }

    @@media (max-width: 768px) {
        .col-md-6 {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .detail-item {
            flex-direction: column;
        }

        .detail-label {
            width: 100%;
            margin-bottom: 5px;
        }
    }
</style>

<div class="container mt-4">

    <div class="header">
        <h2>
            <i class="fa fa-trash"></i>
            Delete Asset
        </h2>
        <p>This action cannot be undone. Please confirm deletion.</p>
    </div>

    <div class="card-custom">

        <div class="warning-box">
            <h5 class="text-danger">
                <i class="fa fa-exclamation-triangle"></i>
                Are you sure you want to delete this asset?
            </h5>
            <p class="mb-0">
                <strong>Warning:</strong> This will permanently delete the asset record from the system.
                All associated data will be removed.
            </p>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Asset Number</span>
                    <span class="detail-value"><strong>@Model.AssetNumber</strong></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Asset Name</span>
                    <span class="detail-value">@Model.AssetName</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Category</span>
                    <span class="detail-value">@Model.Category</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Brand</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(Model.Brand) ? "N/A" : Model.Brand)</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Model</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(Model.Model) ? "N/A" : Model.Model)</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Status</span>
                    <span class="detail-value">
                        @{
                            string statusClass = "status-" + (Model.Status?.ToLower().Replace(" ", "") ?? "available");
                        }
                        <span class="status-badge @statusClass">
                            <i class="fa fa-circle"></i>
                            @Model.Status
                        </span>
                    </span>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.AssignedToUserId))
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="detail-item">
                        <span class="detail-label">Currently Assigned To</span>
                        <span class="detail-value">
                            @{
                                using (var db = new ApplicationDbContext())
                                {
                                    var staff = db.Staff.FirstOrDefault(s => s.UserId == Model.AssignedToUserId);
                                    <span>@(staff?.FullName ?? "Unknown")</span>
                                }
                            }
                        </span>
                    </div>
                </div>
            </div>
        }

        <hr />

        @using (Html.BeginForm("Delete", "Assets", new { id = Model.AssetId }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.AssetId)

            <div class="row">
                <div class="col-md-12">
                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="fa fa-trash"></i>
                        Confirm Delete
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                        <i class="fa fa-arrow-left"></i>
                        Cancel
                    </a>
                </div>
            </div>
        }

    </div>

</div>
