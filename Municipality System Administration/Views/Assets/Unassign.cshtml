@model Municipality_System_Administration.Models.Asset
@using Municipality_System_Administration.Models
@{
    ViewBag.Title = "Unassign Asset";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .header {
        background: linear-gradient(135deg, #ffc107, #e0a800);
        color: #212529;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-custom {
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
    }

    .warning-box {
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .asset-info {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .asset-info-item {
        padding: 5px 0;
    }

    .asset-info-label {
        font-weight: 600;
        color: #6c757d;
    }

    .btn {
        display: inline-block;
        font-weight: 400;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.5rem 1rem;
        font-size: 1rem;
        line-height: 1.5;
        border-radius: 0.25rem;
        transition: color .15s ease-in-out, background-color .15s ease-in-out, border-color .15s ease-in-out, box-shadow .15s ease-in-out;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-warning {
        color: #212529;
        background-color: #ffc107;
        border-color: #ffc107;
    }

        .btn-warning:hover {
            background-color: #e0a800;
            border-color: #d39e00;
        }

    .btn-secondary {
        color: #fff;
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }

    .btn-lg {
        padding: 0.5rem 1rem;
        font-size: 1.25rem;
        line-height: 1.5;
        border-radius: 0.3rem;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -15px;
        margin-left: -15px;
    }

    .col-md-6, .col-md-12 {
        position: relative;
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
    }

    .col-md-6 {
        flex: 0 0 50%;
        max-width: 50%;
    }

    .col-md-12 {
        flex: 0 0 100%;
        max-width: 100%;
    }

    .container {
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        margin-right: auto;
        margin-left: auto;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    hr {
        margin-top: 1rem;
        margin-bottom: 1rem;
        border: 0;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    .text-warning {
        color: #ffc107 !important;
    }

    .mb-0 {
        margin-bottom: 0 !important;
    }

    .alert {
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        border: 1px solid transparent;
        border-radius: 0.25rem;
    }

    .alert-danger {
        color: #721c24;
        background-color: #f8d7da;
        border-color: #f5c6cb;
    }

    .alert-dismissible {
        padding-right: 4rem;
    }

    .close {
        float: right;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        color: #000;
        text-shadow: 0 1px 0 #fff;
        opacity: .5;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
    }

    @@media (max-width: 768px) {
        .col-md-6 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }
</style>

<div class="container mt-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle"></i>
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="header">
        <h2>
            <i class="fa fa-user-slash"></i>
            Unassign Asset
        </h2>
        <p>Return the asset from a staff member.</p>
    </div>

    <div class="card-custom">

        @if (Model != null)
        {
            using (Html.BeginForm("Unassign", "Assets", new { id = Model.AssetId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="warning-box">
                    <h5 class="text-warning">
                        <i class="fa fa-exclamation-triangle"></i>
                        Confirm Unassignment
                    </h5>
                    <p class="mb-0">
                        You are about to unassign this asset from the current staff member.
                        The asset will become available for reassignment.
                    </p>
                </div>

                <div class="asset-info">
                    <h5><i class="fa fa-box"></i> Asset Information</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="asset-info-item">
                                <span class="asset-info-label">Asset Number:</span>
                                <strong>@Model.AssetNumber</strong>
                            </div>
                            <div class="asset-info-item">
                                <span class="asset-info-label">Asset Name:</span>
                                <strong>@Model.AssetName</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="asset-info-item">
                                <span class="asset-info-label">Category:</span>
                                <strong>@Model.Category</strong>
                            </div>
                            <div class="asset-info-item">
                                <span class="asset-info-label">Status:</span>
                                <strong>@Model.Status</strong>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.AssignedToUserId))
                    {
                        using (var db = new ApplicationDbContext())
                        {
                            var staff = db.Staff.FirstOrDefault(s => s.UserId == Model.AssignedToUserId);
                            <div class="asset-info-item">
                                <span class="asset-info-label">Currently Assigned To:</span>
                                <strong>@(staff?.FullName ?? "Unknown")</strong>
                            </div>
                        }
                    }
                </div>

                <hr />

                <div class="row">
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-warning btn-lg">
                            <i class="fa fa-user-slash"></i>
                            Confirm Unassign
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                            <i class="fa fa-arrow-left"></i>
                            Cancel
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-danger">
                <i class="fa fa-exclamation-circle"></i>
                Asset not found or has been deleted.
            </div>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i>
                Back to List
            </a>
        }

    </div>

</div>

