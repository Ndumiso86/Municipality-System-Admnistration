@model IEnumerable<Municipality_System_Administration.Models.Asset>

@{
    ViewBag.Title = "My Assets";
}

<h2>My Assets</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Asset Number</th>
            <th>Name</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AssetNumber</td>
                <td>@item.AssetName</td>
                <td>
                    @if (item.Status == "Repair")
                    {
                        <span class="badge bg-warning text-dark">In Repair</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@item.Status</span>
                    }
                </td>
                <td>
                    @* Only show Request button if it's NOT in repair and NOT already disposed *@
                    @if (item.Status != "Repair" && item.Status != "Disposed")
                    {
                        <a href="@Url.Action("Disposal", "Assets", new { id = item.AssetId })"
                           class="btn btn-warning btn-sm">
                            <i class="fa fa-recycle"></i> Request Disposal
                        </a>
                    }
                    else
                    {
                        <span>No action available</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

