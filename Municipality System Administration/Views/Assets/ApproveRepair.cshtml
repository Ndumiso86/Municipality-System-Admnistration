@using Municipality_System_Administration.Models
@model Municipality_System_Administration.Models.Asset

@{
    ViewBag.Title = "Approve Repair";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .header {
        background: linear-gradient(135deg, #28a745, #1e7e34);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-custom {
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        font-weight: 600;
        margin-bottom: 6px;
    }

    .asset-info {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .asset-info-item {
        padding: 5px 0;
    }

    .asset-info-label {
        font-weight: 600;
        color: #6c757d;
    }

    .form-control {
        display: block;
        width: 100%;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        line-height: 1.5;
        color: #495057;
        background-color: #fff;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
    }

        .form-control:focus {
            border-color: #80bdff;
            outline: 0;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

    .btn {
        display: inline-block;
        font-weight: 400;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.5rem 1rem;
        font-size: 1rem;
        line-height: 1.5;
        border-radius: 0.25rem;
        transition: color .15s ease-in-out, background-color .15s ease-in-out, border-color .15s ease-in-out, box-shadow .15s ease-in-out;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-success {
        color: #fff;
        background-color: #28a745;
        border-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

    .btn-secondary {
        color: #fff;
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }

    .btn-lg {
        padding: 0.5rem 1rem;
        font-size: 1.25rem;
        line-height: 1.5;
        border-radius: 0.3rem;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -15px;
        margin-left: -15px;
    }

    .col-md-6, .col-md-12 {
        position: relative;
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
    }

    .col-md-6 {
        flex: 0 0 50%;
        max-width: 50%;
    }

    .col-md-12 {
        flex: 0 0 100%;
        max-width: 100%;
    }

    .container {
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        margin-right: auto;
        margin-left: auto;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    hr {
        margin-top: 1rem;
        margin-bottom: 1rem;
        border: 0;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    .text-danger {
        color: #dc3545 !important;
    }

    .alert {
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        border: 1px solid transparent;
        border-radius: 0.25rem;
    }

    .alert-danger {
        color: #721c24;
        background-color: #f8d7da;
        border-color: #f5c6cb;
    }

    .alert-success {
        color: #155724;
        background-color: #d4edda;
        border-color: #c3e6cb;
    }

    .alert-dismissible {
        padding-right: 4rem;
    }

    .close {
        float: right;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        color: #000;
        text-shadow: 0 1px 0 #fff;
        opacity: .5;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
    }

    .info-box {
        background: #e8f4fd;
        border-left: 4px solid #28a745;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-completed {
        background: #20c997;
        color: white;
    }

    .status-repaired {
        background: #20c997;
        color: white;
    }

    .condition-badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
        display: inline-block;
    }

    .condition-poor {
        background: #fd7e14;
        color: white;
    }

    .condition-damaged {
        background: #dc3545;
        color: white;
    }

    .condition-good {
        background: #17a2b8;
        color: white;
    }

    .repair-report-box {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 15px;
        max-height: 150px;
        overflow-y: auto;
        white-space: pre-wrap;
        font-family: inherit;
        font-size: 0.9rem;
        margin-top: 5px;
    }

    .assignment-info {
        background: #e8f5e9;
        padding: 10px 15px;
        border-radius: 8px;
        border-left: 4px solid #28a745;
        margin-top: 10px;
    }

    @@media (max-width: 768px) {
        .col-md-6 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }
</style>

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i>
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle"></i>
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="header">
        <h2>
            <i class="fa fa-check-circle"></i>
            Approve Repair
        </h2>
        <p>Review and approve the completed repair for asset: <strong>@Model.AssetNumber</strong></p>
    </div>

    <div class="card-custom">

        @if (Model != null)
        {
            <div class="info-box">
                <i class="fa fa-info-circle"></i>
                <strong>Action:</strong> Approving this repair will:
                <ul class="mb-0 mt-2">
                    <li>Mark the asset as <strong>Available</strong></li>
                    <li>Set condition to <strong>Good</strong></li>
                    <li>Clear any assignment (asset will be unassigned)</li>
                    <li>Complete the repair process</li>
                </ul>
            </div>

            using (Html.BeginForm("ApproveRepair", "Assets", new { id = Model.AssetId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.AssetId)

                <div class="asset-info">
                    <h5><i class="fa fa-box"></i> Asset Information</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="asset-info-item">
                                <span class="asset-info-label">Asset Number:</span>
                                <strong>@Model.AssetNumber</strong>
                            </div>
                            <div class="asset-info-item">
                                <span class="asset-info-label">Asset Name:</span>
                                <strong>@Model.AssetName</strong>
                            </div>
                            <div class="asset-info-item">
                                <span class="asset-info-label">Category:</span>
                                <strong>@Model.Category</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="asset-info-item">
                                <span class="asset-info-label">Current Condition:</span>
                                @{
                                    string currentConditionClass = "condition-" + (Model.Condition?.ToLower() ?? "good");
                                }
                                <span class="condition-badge @currentConditionClass">
                                    @Model.Condition
                                </span>
                            </div>
                            <div class="asset-info-item">
                                <span class="asset-info-label">Current Status:</span>
                                <span class="status-badge status-completed">
                                    <i class="fa fa-circle"></i>
                                    @Model.Status
                                </span>
                            </div>
                            <div class="asset-info-item">
                                <span class="asset-info-label">Repair Status:</span>
                                <span class="status-badge status-completed">
                                    <i class="fa fa-tools"></i>
                                    @Model.RepairStatus
                                </span>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.AssignedToUserId))
                    {
                        using (var db = new ApplicationDbContext())
                        {
                            var staff = db.Staff.FirstOrDefault(s => s.UserId == Model.AssignedToUserId);
                            <div class="assignment-info">
                                <i class="fa fa-user"></i>
                                <strong>Currently Assigned To:</strong> @(staff?.FullName ?? "Unknown")
                                <br />
                                <small class="text-muted">
                                    <i class="fa fa-info-circle"></i>
                                    This asset will be unassigned upon approval.
                                </small>
                            </div>
                        }
                    }

                    @if (!string.IsNullOrEmpty(Model.RepairAssignedToUserId))
                    {
                        using (var db = new ApplicationDbContext())
                        {
                            var tech = db.Staff.FirstOrDefault(s => s.UserId == Model.RepairAssignedToUserId);
                            <div class="asset-info-item">
                                <span class="asset-info-label">Repair Technician:</span>
                                <strong>@(tech?.FullName ?? "Unknown")</strong>
                            </div>
                        }
                    }

                    @if (!string.IsNullOrEmpty(Model.RepairReport))
                    {
                        <div class="asset-info-item">
                            <span class="asset-info-label">Repair Report:</span>
                            <div class="repair-report-box">
                                @Html.Raw(Model.RepairReport.Replace("\n", "<br />"))
                            </div>
                        </div>
                    }

                    @if (Model.RepairCost.HasValue && Model.RepairCost.Value > 0)
                    {
                        <div class="asset-info-item">
                            <span class="asset-info-label">Repair Cost:</span>
                            <strong>@Model.RepairCost.Value.ToString("C2")</strong>
                        </div>
                    }
                </div>

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    <label for="Notes">Approval Notes</label>
                    <textarea name="Notes" class="form-control" rows="3" placeholder="Add any notes about this approval..."></textarea>
                    <small class="text-muted">
                        <i class="fa fa-info-circle"></i>
                        These notes will be added to the asset's history.
                    </small>
                </div>

                <hr />

                <div class="row">
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fa fa-check-circle"></i>
                            Approve Repair
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                            <i class="fa fa-arrow-left"></i>
                            Cancel
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-danger">
                <i class="fa fa-exclamation-circle"></i>
                Asset not found or has been deleted.
            </div>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i>
                Back to List
            </a>
        }

    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

