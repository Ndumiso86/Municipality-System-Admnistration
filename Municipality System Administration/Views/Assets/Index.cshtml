@using Municipality_System_Administration.Models
@using Municipality_System_Administration.Controllers
@using Microsoft.AspNet.Identity
@model IEnumerable<Municipality_System_Administration.Models.Asset>

@{
    ViewBag.Title = "Asset Management";
    var currentUserId = User.Identity.IsAuthenticated ? User.Identity.GetUserId() : null;
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .page-header {
        background: linear-gradient(135deg, #0f4c81, #1f7a8c);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .card-box {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
    }

    .stat-card {
        background: white;
        padding: 15px;
        border-radius: 10px;
        text-align: center;
        box-shadow: 0 2px 10px rgba(0, 0, 0, .06);
        border-left: 4px solid #0f4c81;
    }

    .stat-number {
        font-size: 1.8rem;
        font-weight: bold;
        color: #0f4c81;
    }

    .stat-label {
        color: #6c757d;
        font-size: 0.85rem;
    }

    .table thead {
        background: #0f4c81;
        color: white;
    }

        .table thead th {
            color: white;
            padding: 12px 15px;
        }

    .table tbody td {
        padding: 12px 15px;
        vertical-align: middle;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-available {
        background: #28a745;
        color: white;
    }

    .status-assigned {
        background: #007bff;
        color: white;
    }

    .status-pendingrepair {
        background: #fd7e14;
        color: white;
    }

    .status-inrepair {
        background: #ffc107;
        color: #212529;
    }

    .status-repaired {
        background: #20c997;
        color: white;
    }

    .status-disposed {
        background: #dc3545;
        color: white;
    }

    .status-lost {
        background: #6c757d;
        color: white;
    }

    .status-stolen {
        background: #343a40;
        color: white;
    }

    .condition-badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
        display: inline-block;
    }

    .condition-new {
        background: #28a745;
        color: white;
    }

    .condition-excellent {
        background: #20c997;
        color: white;
    }

    .condition-good {
        background: #17a2b8;
        color: white;
    }

    .condition-fair {
        background: #ffc107;
        color: #212529;
    }

    .condition-poor {
        background: #fd7e14;
        color: white;
    }

    .condition-damaged {
        background: #dc3545;
        color: white;
    }

    .repair-badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
        display: inline-block;
    }

    .repair-pending {
        background: #fd7e14;
        color: white;
    }

    .repair-inprogress {
        background: #ffc107;
        color: #212529;
    }

    .repair-completed {
        background: #20c997;
        color: white;
    }

    .repair-approved {
        background: #28a745;
        color: white;
    }

    .filter-section {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .action-buttons {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

        .action-buttons .btn {
            margin: 2px;
            min-width: 32px;
            cursor: pointer;
            pointer-events: auto;
            z-index: 10;
            position: relative;
        }

            .action-buttons .btn i {
                pointer-events: none;
            }

            .action-buttons .btn:hover {
                transform: scale(1.05);
            }

    .table tbody tr {
        position: relative;
    }

        .table tbody tr .action-buttons .btn {
            position: relative;
            z-index: 100;
        }

    .btn-sm {
        padding: 4px 10px;
        font-size: 12px;
        line-height: 1.5;
        border-radius: 4px;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 30px;
    }

        .btn-sm i {
            font-size: 13px;
        }

    .table tbody td:last-child {
        z-index: 1;
        position: relative;
    }

    .action-buttons .btn-primary:hover {
        background: #0069d9;
        border-color: #0062cc;
    }

    .action-buttons .btn-info:hover {
        background: #138496;
        border-color: #117a8b;
    }

    .action-buttons .btn-warning:hover {
        background: #e0a800;
        border-color: #d39e00;
        color: white;
    }

    .action-buttons .btn-success:hover {
        background: #1e7e34;
        border-color: #1c7430;
    }

    .action-buttons .btn-danger:hover {
        background: #c82333;
        border-color: #bd2130;
    }

    .clearfix::after {
        content: "";
        clear: both;
        display: table;
    }

    .search-box {
        max-width: 300px;
        display: inline-block;
    }

    .filter-select {
        display: inline-block;
        margin-right: 10px;
    }

    .asset-count {
        background: rgba(255, 255, 255, 0.2);
        padding: 8px 15px;
        border-radius: 20px;
        font-weight: 600;
        color: white;
        display: inline-block;
        margin-left: 15px;
        font-size: 0.9rem;
    }

    .btn-recycle {
        background: #fd7e14;
        color: white;
    }

        .btn-recycle:hover {
            background: #e06b0a;
            color: white;
        }

    .btn-disposal {
        background: #6c757d;
        color: white;
    }

        .btn-disposal:hover {
            background: #5a6268;
            color: white;
        }

    .action-buttons .btn {
        margin: 2px;
        min-width: 32px;
        cursor: pointer;
        pointer-events: auto;
        z-index: 10;
        position: relative;
    }

        .action-buttons .btn i {
            pointer-events: none;
        }

        .action-buttons .btn:hover {
            transform: scale(1.05);
        }

    .btn-assign {
        background: #28a745;
        color: white;
    }

        .btn-assign:hover {
            background: #218838;
            color: white;
        }

    .btn-unassign {
        background: #ffc107;
        color: #212529;
    }

        .btn-unassign:hover {
            background: #e0a800;
            color: #212529;
        }

    .btn-repair {
        background: #fd7e14;
        color: white;
    }

        .btn-repair:hover {
            background: #e06b0a;
            color: white;
        }

    .btn-approve {
        background: #28a745;
        color: white;
    }

        .btn-approve:hover {
            background: #1e7e34;
            color: white;
        }

    .badge-secondary {
        background: #6c757d;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .badge-info {
        background: #17a2b8;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .btn-warning {
        color: #212529;
        background-color: #ffc107;
        border-color: #ffc107;
    }

        .btn-warning:hover {
            background-color: #e0a800;
            border-color: #d39e00;
            color: #212529;
        }

    .text-muted {
        color: #6c757d !important;
    }

    .text-center {
        text-align: center !important;
    }

    .py-5 {
        padding-top: 3rem !important;
        padding-bottom: 3rem !important;
    }

    .mb-3 {
        margin-bottom: 1rem !important;
    }

    .mt-3 {
        margin-top: 1rem !important;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    .mb-4 {
        margin-bottom: 1.5rem !important;
    }

    .float-left {
        float: left !important;
    }

    .float-right {
        float: right !important;
    }

    .form-inline {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }

    .form-control {
        display: block;
        width: 100%;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        line-height: 1.5;
        color: #495057;
        background-color: #fff;
        background-clip: padding-box;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        transition: border-color .15s ease-in-out,box-shadow .15s ease-in-out;
    }

    .btn {
        display: inline-block;
        font-weight: 400;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        line-height: 1.5;
        border-radius: 0.25rem;
        transition: color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out;
        text-decoration: none;
    }

    .btn-success {
        color: #fff;
        background-color: #28a745;
        border-color: #28a745;
    }

    .btn-secondary {
        color: #fff;
        background-color: #6c757d;
        border-color: #6c757d;
    }

    .btn-primary {
        color: #fff;
        background-color: #007bff;
        border-color: #007bff;
    }

    .btn-info {
        color: #fff;
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

    .btn-danger {
        color: #fff;
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .btn-warning {
        color: #212529;
        background-color: #ffc107;
        border-color: #ffc107;
    }

    .btn-lg {
        padding: 0.5rem 1rem;
        font-size: 1.25rem;
        line-height: 1.5;
        border-radius: 0.3rem;
    }

    .alert {
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        border: 1px solid transparent;
        border-radius: 0.25rem;
    }

    .alert-success {
        color: #155724;
        background-color: #d4edda;
        border-color: #c3e6cb;
    }

    .alert-danger {
        color: #721c24;
        background-color: #f8d7da;
        border-color: #f5c6cb;
    }

    .alert-dismissible {
        padding-right: 4rem;
    }

    .close {
        float: right;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        color: #000;
        text-shadow: 0 1px 0 #fff;
        opacity: .5;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
    }

    .fade {
        opacity: 0;
        transition: opacity .15s linear;
    }

    .show {
        opacity: 1;
    }

    .table {
        width: 100%;
        margin-bottom: 1rem;
        background-color: transparent;
        border-collapse: collapse;
    }

    .table-bordered {
        border: 1px solid #dee2e6;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.075);
    }

    .table-responsive {
        display: block;
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .container {
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        margin-right: auto;
        margin-left: auto;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -15px;
        margin-left: -15px;
    }

    .col-md-3, .col-md-4, .col-md-6, .col-md-8, .col-md-12 {
        position: relative;
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
    }

    .col-md-3 {
        flex: 0 0 25%;
        max-width: 25%;
    }

    .col-md-4 {
        flex: 0 0 33.333333%;
        max-width: 33.333333%;
    }

    .col-md-6 {
        flex: 0 0 50%;
        max-width: 50%;
    }

    .col-md-8 {
        flex: 0 0 66.666667%;
        max-width: 66.666667%;
    }

    .col-md-12 {
        flex: 0 0 100%;
        max-width: 100%;
    }

    .repair-tooltip {
        cursor: help;
        border-bottom: 1px dashed #6c757d;
    }

    .repair-needed {
        background: #dc3545;
        color: white;
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.65rem;
        font-weight: 600;
        display: inline-block;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }
    }

    @@media (max-width: 768px) {
        .table-responsive {
            overflow-x: auto;
        }

        .action-buttons .btn {
            min-width: 28px;
            height: 28px;
            padding: 3px 8px;
        }

            .action-buttons .btn i {
                font-size: 11px;
            }

        .search-box {
            max-width: 100%;
            margin-top: 10px;
        }

        .filter-select {
            display: block;
            margin-bottom: 10px;
            width: 100%;
        }

        .stat-card {
            margin-bottom: 10px;
        }

        .float-left, .float-right {
            float: none !important;
        }

        .clearfix {
            text-align: center;
        }

        .col-md-3, .col-md-4, .col-md-6, .col-md-8, .col-md-12 {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .form-inline {
            display: block;
        }
    }
</style>

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i>
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle"></i>
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="page-header">
        <h2>
            <i class="fa fa-building"></i>
            Asset Management
            <span class="asset-count">
                <i class="fa fa-boxes"></i>
                @Model.Count() Assets
            </span>
        </h2>
        <p>
            Manage municipal assets, track assignments, repairs and maintenance.
        </p>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #28a745;">
                <div class="stat-number">@ViewBag.TotalAssets</div>
                <div class="stat-label"><i class="fa fa-boxes"></i> Total Assets</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #17a2b8;">
                <div class="stat-number">@ViewBag.AvailableAssets</div>
                <div class="stat-label"><i class="fa fa-check-circle"></i> Available</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #007bff;">
                <div class="stat-number">@ViewBag.AssignedAssets</div>
                <div class="stat-label"><i class="fa fa-user-check"></i> Assigned</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #fd7e14;">
                <div class="stat-number">@ViewBag.InRepair</div>
                <div class="stat-label"><i class="fa fa-tools"></i> In Repair</div>
            </div>
        </div>
    </div>

    <div class="card-box">

        <div class="filter-section">
            <div class="row">
                <div class="col-md-8">
                    <div class="form-inline">
                        <div class="filter-select">
                            <select id="categoryFilter" class="form-control" onchange="applyFilters()">
                                <option value="All">All Categories</option>
                                @{
                                    var categories = new List<string>
                                                            {
                                        "Computer", "Laptop", "Printer", "Vehicle", "Office Furniture",
                                        "Generator", "Air Conditioner", "Projector", "Network Equipment",
                                        "Mobile Device", "Electrical Equipment", "Tool", "Building Equipment",
                                        "Furniture", "Medical Equipment", "Other"
                                    };
                                }
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat" @(ViewBag.SelectedCategory == cat ? "selected" : "")>@cat</option>
                                }
                            </select>
                        </div>
                        <div class="filter-select">
                            <select id="statusFilter" class="form-control" onchange="applyFilters()">
                                <option value="All">All Statuses</option>
                                @{
                                    var statuses = new List<string>
                                                            {
                                        "Available", "Assigned", "Pending Repair", "In Repair", "Repaired", "Disposed", "Lost", "Stolen"
                                    };
                                }
                                @foreach (var stat in statuses)
                                {
                                    <option value="@stat" @(ViewBag.SelectedStatus == stat ? "selected" : "")>@stat</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="float-right">
                        <input type="text" id="searchInput" class="form-control search-box" placeholder="Search assets..." value="@ViewBag.SearchTerm" />
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix mb-3">
            <div class="float-left">
                @if (User.IsInRole("Admin") || User.IsInRole("AssetManager"))
                {
                    <a href="@Url.Action("Create")" class="btn btn-success">
                        <i class="fa fa-plus-circle"></i>
                        Add New Asset
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fa fa-sync"></i>
                        Reset
                    </a>
                }
                @if (User.IsInRole("Technician"))
                {
                    <a href="@Url.Action("RepairQueue", "Technician")" class="btn btn-repair">
                        <i class="fa fa-tools"></i>
                        Repair Queue
                        <span class="badge badge-light" id="repairCount">0</span>
                    </a>
                }
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered" id="assetTable">
                <thead>
                    <tr>
                        <th>Asset No</th>
                        <th>Asset Name</th>
                        <th>Category</th>
                        <th>Brand/Model</th>
                        <th>Status</th>
                        <th>Condition</th>
                        <th>Assigned To</th>
                        <th>Repair Status</th>
                        <th style="min-width: 250px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        using (var db = new ApplicationDbContext())
                        {
                            foreach (var item in Model)
                            {
                                string statusClass = "status-" + (item.Status?.ToLower().Replace(" ", "") ?? "available");
                                string conditionClass = "condition-" + (item.Condition?.ToLower() ?? "good");
                                string repairStatusClass = "repair-" + (item.RepairStatus?.ToLower() ?? "");
                                bool needsRepair = (item.Condition == "Poor" || item.Condition == "Damaged" || item.Condition == "For Repair");

                                <tr>
                                    <td>
                                        <strong>@item.AssetNumber</strong>
                                    </td>
                                    <td>
                                        <i class="fa fa-box"></i>
                                        @item.AssetName
                                        @if (needsRepair && !item.RepairRequested)
                                        {
                                            <span class="repair-needed">
                                                <i class="fa fa-exclamation-triangle"></i> Needs Repair
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge-secondary">@item.Category</span>
                                    </td>
                                    <td>
                                        @item.Brand
                                        @if (!string.IsNullOrEmpty(item.Model))
                                        {
                                            <small class="text-muted">/ @item.Model</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="status-badge @statusClass">
                                            <i class="fa fa-circle"></i>
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span class="condition-badge @conditionClass">
                                            @item.Condition
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.AssignedToUserId))
                                        {
                                            var staff = db.Staff.FirstOrDefault(s => s.UserId == item.AssignedToUserId);
                                            <span class="badge-info">
                                                <i class="fa fa-user"></i>
                                                @(staff?.FullName ?? "Unknown")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Assigned</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.RepairStatus))
                                        {
                                            <span class="repair-badge @repairStatusClass">
                                                <i class="fa fa-tools"></i>
                                                @item.RepairStatus
                                            </span>
                                            if (!string.IsNullOrEmpty(item.RepairReport))
                                            {
                                                <i class="fa fa-info-circle text-muted repair-tooltip"
                                                   title="@item.RepairReport"
                                                   style="cursor:help; margin-left: 5px;"></i>
                                            }
                                        }
                                        else if (needsRepair)
                                        {
                                            <span class="repair-badge repair-pending">
                                                <i class="fa fa-exclamation-triangle"></i>
                                                Repair Needed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No Repair</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-buttons">

                                            <a href="@Url.Action("Details", "Assets", new { id = item.AssetId })"
                                               class="btn btn-info btn-sm"
                                               title="View Details">
                                                <i class="fa fa-eye"></i>
                                            </a>

                                            <!-- Maintenance Button -->
                                            @if (User.IsInRole("Admin") || User.IsInRole("AssetManager") || User.IsInRole("Technician"))
                                            {
                                                <a href="@Url.Action("Index", "Maintenance", new { assetId = item.AssetId })"
                                                   class="btn btn-secondary btn-sm"
                                                   title="View Maintenance">
                                                    <i class="fa fa-wrench"></i>
                                                </a>
                                            }

                                            @if (User.Identity.IsAuthenticated && item.Status != "Disposed" && item.IsActive)
                                            {
                                                // Use the existing db context - DON'T declare a new one
                                                var existingRequest = db.DisposalRequests
                                                    .FirstOrDefault(r => r.AssetId == item.AssetId &&
                                                                         (r.Status == "Pending" || r.Status == "Reviewed" || r.Status == "Approved"));

                                                if (existingRequest == null)
                                                {
                                                    <a href="@Url.Action("Disposal", "Assets", new { id = item.AssetId })"
                                                       class="btn btn-warning btn-sm"
                                                       title="Request Disposal">
                                                        <i class="fa fa-recycle"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a href="@Url.Action("Details", "Disposal", new { id = existingRequest.DisposalRequestId })"
                                                       class="btn btn-secondary btn-sm"
                                                       title="View Disposal Request">
                                                        <i class="fa fa-clock"></i>
                                                    </a>
                                                }
                                            }


                                            @if (User.IsInRole("Admin") || User.IsInRole("AssetManager"))
                                            {

                                                <a href="@Url.Action("UpdateStatus", "Assets", new { id = item.AssetId })"
                                                   class="btn btn-warning btn-sm"
                                                   title="Update Status">
                                                    <i class="fa fa-exchange-alt"></i>
                                                </a>


                                                <a href="@Url.Action("Edit", "Assets", new { id = item.AssetId })"
                                                   class="btn btn-primary btn-sm"
                                                   title="Edit Asset">
                                                    <i class="fa fa-edit"></i>
                                                </a>


                                                if (needsRepair && !item.RepairRequested && item.Status != "Pending Repair" && item.Status != "In Repair")
                                                {
                                                    <a href="@Url.Action("RequestRepair", "Assets", new { id = item.AssetId })"
                                                       class="btn btn-repair btn-sm"
                                                       title="Request Repair">
                                                        <i class="fa fa-tools"></i>
                                                    </a>
                                                }

                                                if (item.RepairStatus == "Completed")
                                                {
                                                    <a href="@Url.Action("ApproveRepair", "Assets", new { id = item.AssetId })"
                                                       class="btn btn-approve btn-sm"
                                                       title="Approve Repair">
                                                        <i class="fa fa-check-circle"></i>
                                                    </a>
                                                }

                                                if (item.Status == "Assigned")
                                                {
                                                    <a href="@Url.Action("Unassign", "Assets", new { id = item.AssetId })"
                                                       class="btn btn-unassign btn-sm"
                                                       title="Unassign Asset"
                                                       onclick="return confirm('Are you sure you want to unassign this asset?');">
                                                        <i class="fa fa-user-slash"></i>
                                                    </a>
                                                }
                                                else if (item.Status == "Available" && (item.RepairStatus != "Pending" && item.RepairStatus != "In Progress" && !needsRepair))
                                                {
                                                    <a href="@Url.Action("Assign", "Assets", new { id = item.AssetId })"
                                                       class="btn btn-assign btn-sm"
                                                       title="Assign Asset">
                                                        <i class="fa fa-user-plus"></i>
                                                    </a>
                                                }

                                                <a href="@Url.Action("Delete", "Assets", new { id = item.AssetId })"
                                                   class="btn btn-danger btn-sm"
                                                   title="Delete Asset"
                                                   onclick="return confirm('Are you sure you want to delete this asset? This action cannot be undone.');">
                                                    <i class="fa fa-trash"></i>
                                                </a>

                                                if (User.IsInRole("Admin") || User.IsInRole("AssetManager"))
                                                {
                                                    if (item.Status != "Disposed" && item.Status != "Assigned")
                                                    {
                                                        <a href="@Url.Action("Disposal", "Assets", new { id = item.AssetId })"
                                                           class="btn btn-warning btn-sm"
                                                           title="Dispose Asset (Formal Retirement)">
                                                            <i class="fa fa-recycle"></i>
                                                        </a>
                                                    }
                                                }

                                                <a href="@Url.Action("Decommission", "Assets", new { id = item.AssetId })"
                                                   class="btn btn-danger btn-sm"
                                                   title="Decommission Asset"
                                                   onclick="return confirm('Are you sure you want to decommission this asset? This will remove it from active service.');">
                                                    <i class="fa fa-trash-alt"></i>
                                                </a>

                                                if (item.RepairRequested && string.IsNullOrEmpty(item.RepairAssignedToUserId))
                                                {
                                                    <a href="@Url.Action("AssignTechnician", "Assets", new { id = item.AssetId })"
                                                       class="btn btn-warning btn-sm"
                                                       title="Assign Technician">
                                                        <i class="fa fa-user-cog"></i>
                                                    </a>
                                                }
                                            }

                                            @if (User.IsInRole("Technician"))
                                            {
                                                @*  *@
                                                if (item.RepairStatus == "Pending" && item.RepairAssignedToUserId == currentUserId)
                                                {
                                                    <a href="@Url.Action("StartRepair", "Technician", new { id = item.AssetId })"
                                                       class="btn btn-primary btn-sm"
                                                       title="Start Repair">
                                                        <i class="fa fa-play"></i>
                                                    </a>
                                                }

                                                @*  *@
                                                if (item.RepairStatus == "In Progress" && item.RepairAssignedToUserId == currentUserId)
                                                {
                                                    <a href="@Url.Action("CompleteRepair", "Technician", new { id = item.AssetId })"
                                                       class="btn btn-success btn-sm"
                                                       title="Complete Repair">
                                                        <i class="fa fa-check"></i>
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9">
                                <div class="text-center py-5">
                                    <i class="fa fa-boxes fa-3x text-muted mb-3"></i>
                                    <h4>No assets found</h4>
                                    <p class="text-muted">Click "Add New Asset" to create your first asset record.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-muted">
            <small>
                <i class="fa fa-info-circle"></i>
                Total: <strong>@Model.Count()</strong> assets
                | Available: <strong>@Model.Count(a => a.Status == "Available")</strong>
                | Assigned: <strong>@Model.Count(a => a.Status == "Assigned")</strong>
                | Pending Repair: <strong>@Model.Count(a => a.Status == "Pending Repair")</strong>
                | In Repair: <strong>@Model.Count(a => a.Status == "In Repair")</strong>
                | Repaired: <strong>@Model.Count(a => a.Status == "Repaired")</strong>
            </small>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var searchTimeout;
            $('#searchInput').on('keyup', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function () {
                    applyFilters();
                }, 300);
            });

            $('#searchInput').on('keypress', function (e) {
                if (e.which === 13) {
                    applyFilters();
                }
            });

            updateRepairCount();

            setInterval(updateRepairCount, 30000);

            $('.btn-danger').on('click', function(e) {
                if (!confirm('Are you sure you want to delete this asset? This action cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }
                return true;
            });

            $('.btn-unassign').on('click', function(e) {
                if (!confirm('Are you sure you want to unassign this asset?')) {
                    e.preventDefault();
                    return false;
                }
                return true;
            });
        });

        function applyFilters() {
            var search = $('#searchInput').val();
            var category = $('#categoryFilter').val();
            var status = $('#statusFilter').val();

            var url = '@Url.Action("Index")';
            var params = [];

            if (search) params.push('search=' + encodeURIComponent(search));
            if (category && category !== 'All') params.push('category=' + encodeURIComponent(category));
            if (status && status !== 'All') params.push('status=' + encodeURIComponent(status));

            if (params.length > 0) {
                url += '?' + params.join('&');
            }

            window.location.href = url;
        }

        function updateRepairCount() {
            @if (User.IsInRole("Technician"))
            {
                <text>
                $.ajax({
                    url: '@Url.Action("GetRepairCount", "Technician")',
                    type: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        if (data && data.count !== undefined) {
                            $('#repairCount').text(data.count);
                        }
                    },
                    error: function () {
                    }
                });
                </text>
            }
        }

        $(document).on('keydown', function (e) {
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                $('#searchInput').focus().select();
            }
            if (e.key === 'Escape') {
                $('#searchInput').val('');
                applyFilters();
            }
        });
    </script>
}

